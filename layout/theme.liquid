        <script>
          /* Stamp the browsed market context onto the ORDER, so Brevo learns
             which storefront the buyer came from. The order's own locale
             cannot supply it — it has repeatedly reported markets matching
             neither the storefront, the buyer, nor the shipping country.

             It rides TWO carriers, because neither one reaches every order:

               - CART attributes, which an order placed through the cart or the
                 add-to-cart drawer carries; and
               - hidden LINE ITEM properties on every product form, which is
                 all an EXPRESS checkout carries. The branded wallet buttons
                 under the product form — Shop Pay, PayPal, Apple Pay, Google
                 Pay, rendered by the payment_button filter inside
                 .custom-payment-btn — build a checkout straight from that form
                 and never touch the cart, so a cart attribute cannot exist on
                 one of those orders however well it was written. Dynamic
                 checkout is on in all four product templates, so this was
                 never a rare route: it is why some orders reached Brevo with a
                 market, a language and a path while others arrived bare.

                 (The theme's own "Buy it now" text button beside them is NOT
                 that route today. It carries class ctm-buy-btn while the
                 handler that proxies it to the wallet button looks for
                 ctm_buy_it_now, which nothing carries — so, being a bare
                 <button> inside the form, it submits as an ordinary add to
                 cart. That is a separate defect; the wallet button beside it
                 is the express route either way.)

             The properties also settle a race the attributes have on their
             own: an attribute only sticks to a cart that HAS ITEMS, so the
             first write has to wait for the add to land, and a shopper who
             adds one item and goes straight to checkout can be gone before it
             does. A property rides the add itself — there is nothing to wait
             for and nothing to miss.

             Shopify drops an empty attribute and an empty property alike, so
             the path is carried only where there IS one: the primary market's
             path is '' by design (Brevo builds URLs as domain + PATH + /page)
             and _st_market says 'primary' there. A missing _st_path and the
             primary market's empty path are the same state, as they always
             were — read the MARKET, never the path, to tell a primary-market
             order from an unstamped one.

             docs/spikes/market-stamp.mjs runs the block between the markers
             below against a scripted DOM; keep them where they are. */
          /* st-market-stamp-start */
          (function () {
            /* snippets/market-context.liquid holds the resolution — the URL
               as the ground truth, routes.root_url behind it. It used to
               live here, and the three signup forms each carried a version
               that trusted routes.root_url alone; one function is what stops
               the four drifting apart again. */
            var ctx = window.STMarket();
            var path = ctx.path;
            var mkt = ctx.market;
            var lang = ctx.language;
            var stamp = { _st_path: path, _st_market: mkt, _st_lang: lang };
            var keys = ['_st_path', '_st_market', '_st_lang'];

            /* ---------- The carrier an express checkout has ----------

               Every product form gets the three as hidden line item
               properties. The underscore keeps them off the customer's order
               confirmation and out of the emails; Shopify still carries them
               onto the order, where Flow reads them off the line. */
            var ADD_FORM = 'form[action*="/cart/add"]';

            function stampForm(form) {
              for (var i = 0; i < keys.length; i++) {
                var name = 'properties[' + keys[i] + ']';
                var input = form.querySelector('input[name="' + name + '"]');
                if (!stamp[keys[i]]) {
                  /* Shopify drops an empty property, so an input carrying
                     nothing is a line of markup that says nothing. */
                  if (input && input.parentNode) input.parentNode.removeChild(input);
                  continue;
                }
                if (!input) {
                  input = document.createElement('input');
                  input.type = 'hidden';
                  input.name = name;
                  form.appendChild(input);
                }
                input.value = stamp[keys[i]];
              }
            }

            function stampForms(root) {
              var forms = (root || document).querySelectorAll(ADD_FORM);
              for (var i = 0; i < forms.length; i++) stampForm(forms[i]);
            }

            stampForms();

            /* Quick-add, a re-rendered section and the page builders all mount
               their form after this script runs, so a form that arrives later
               is stamped when it arrives rather than left bare. */
            if (window.MutationObserver) {
              new MutationObserver(function (records) {
                for (var i = 0; i < records.length; i++) {
                  var added = records[i].addedNodes;
                  for (var j = 0; j < added.length; j++) {
                    var n = added[j];
                    if (!n || n.nodeType !== 1) continue;
                    if (n.matches && n.matches(ADD_FORM)) stampForm(n);
                    else if (n.querySelectorAll) stampForms(n);
                  }
                }
              }).observe(document.documentElement, { childList: true, subtree: true });
            }

            /* ---------- The carrier the cart and the drawer have ----------

               Shopify only persists attributes on a cart that HAS ITEMS, and
               sets the cart cookie even while empty, so item count decides
               when to write — never the cookie. */
            var busy = false;
            var again = false;

            // Shopify drops empty-string attributes, so a missing _st_path
            // and the primary market's empty path are the same state.
            function stale(a) {
              return (a._st_path || '') !== path
                || (a._st_market || '') !== mkt
                || (a._st_lang || '') !== lang;
            }

            /* Always read the live cart rather than server-rendered values:
               a cached page (or a nil rendering inside the expression) must
               never be able to break or skip the check. */
            function sync() {
              if (busy) {
                /* A call that arrives mid-flight is the one that knows the
                   cart has just changed; dropped, the ladder below collapses
                   back into a single attempt. */
                again = true;
                return;
              }
              busy = true;
              fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (cart) {
                  if (!cart || !cart.item_count || !stale(cart.attributes || {})) return null;
                  return fetch('/cart/update.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ attributes: stamp })
                  });
                })
                .catch(function () {})
                .then(function () {
                  busy = false;
                  if (again) {
                    again = false;
                    sync();
                  }
                });
            }

            sync();

            /* …and again after anything that can create or change a cart. One
               look 800ms after the click was a guess at how long an add takes:
               slower than that and the cart was still empty when it looked, so
               nothing was written and nothing looked again. A ladder costs
               three cheap reads and stops guessing. */
            document.addEventListener('click', function (e) {
              var t = e.target;
              if (!t || !t.closest) return;
              if (t.closest('[name="add"], .product-form__submit, .ctm-buy-btn, [name="checkout"], .cart__checkout-button, [href*="/checkout"]')) {
                setTimeout(sync, 300);
                setTimeout(sync, 1200);
                setTimeout(sync, 2600);
              }
            }, true);
          })();
          /* st-market-stamp-end */
        </script>

