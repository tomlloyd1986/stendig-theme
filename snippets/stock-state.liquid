{%- liquid
  # Emits the stock-state token for a product, or for one specific variant:
  # 'sold_out' (red dot) beats 'last_few' (orange dot); empty = no pill.
  #
  # Availability prefers the warehouse metafields — custom.oos_warehouses /
  # _manual on product and variant, the same source the product page's
  # waitlist logic uses — resolved for the warehouse serving this market's
  # subfolder ('/en-au' -> 'au'; root domain -> 'main'). When no metafield
  # is set, Shopify's native availability decides. 'Last few' uses the
  # tracked quantity (per-warehouse counts aren't exposed to Liquid) and
  # only shows when the warehouse says available.
  #
  # Accepts:
  # - product: {Object} the product
  # - variant: {Object} optional; scopes the check to one variant
  #
  # Callers capture the render output and MUST strip it before comparing
  # (see product-card / product-related) — engines can leave whitespace
  # in the capture. No tag-like text may appear in this doc block: a
  # literal percent-brace sequence would terminate this liquid tag early
  # at tokenization.

  assign wh_current = ''
  assign wh_default = ''
  assign wh_mk = 'main'
  if routes.root_url != '/'
    assign wh_mk = routes.root_url | remove_first: '/' | split: '-' | last | downcase
  endif
  for wh in settings.warehouses
    assign wh_loc = wh.location.value | strip | downcase
    if wh_loc == blank
      continue
    endif
    if wh.is_default.value and wh_default == ''
      assign wh_default = wh_loc
    endif
    if wh.domains.value
      for wh_d in wh.domains.value
        assign wh_dd = wh_d | strip | downcase
        if wh_dd == wh_mk
          assign wh_current = wh_loc
        endif
      endfor
    endif
  endfor
  if wh_current == ''
    assign wh_current = wh_default
  endif

  assign oos_l_ap = product.metafields.custom.oos_warehouses.value
  assign oos_l_mp = product.metafields.custom.oos_warehouses_manual.value
  if variant
    assign oos_l_av = variant.metafields.custom.oos_warehouses.value
    assign oos_l_mv = variant.metafields.custom.oos_warehouses_manual.value
  endif

  assign wh_lists_set = false
  if oos_l_ap or oos_l_mp or oos_l_av or oos_l_mv
    assign wh_lists_set = true
  endif

  assign wh_out = false
  if wh_lists_set
    for w in oos_l_mp
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_mv
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_ap
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_av
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
  endif

  assign stock_state = ''
  if wh_lists_set
    if wh_out
      assign stock_state = 'sold_out'
    elsif variant
      if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 50
        assign stock_state = 'last_few'
      endif
    elsif product != blank
      assign stock_total = 0
      assign stock_tracked = false
      for v in product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  elsif variant
    if variant.available == false
      assign stock_state = 'sold_out'
    elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 50
      assign stock_state = 'last_few'
    endif
  elsif product != blank
    if product.available == false
      assign stock_state = 'sold_out'
    else
      assign stock_total = 0
      assign stock_tracked = false
      for v in product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  endif

  echo stock_state
-%}
