{%- liquid
  # Emits the stock-state token for a product, or for one specific variant:
  # 'sold_out' (red dot) beats 'last_few' (orange dot); empty = no pill.
  #
  # Availability prefers the warehouse metafields — custom.oos_warehouses /
  # _manual on product and variant, the same source the product page's
  # waitlist logic uses — resolved for the warehouse serving this market's
  # subfolder ('/en-au' -> 'au'; root domain -> 'main'). Some products
  # (the Stendig) carry the lists on their variants with the product
  # level empty, so a product-scoped check also counts as out when every
  # variant's own list says out for this warehouse. When no metafield is
  # set anywhere, Shopify's native availability decides. 'Last few' uses
  # the tracked quantity (per-warehouse counts aren't exposed to Liquid)
  # and only shows when the warehouse says available.
  #
  # Accepts:
  # - product: {Object} the product
  # - variant: {Object} optional; scopes the check to one variant
  #
  # Callers capture the render output and MUST strip it before comparing
  # (see product-card / product-related) — engines can leave whitespace
  # in the capture. No tag-like text may appear in this doc block: a
  # literal percent-brace sequence would terminate this liquid tag early
  # at tokenization.

  # wh_open: the warehouse serving this market has "Sell regardless of
  # stock" ticked (the warehouse entry's sell_regardless field). Read here,
  # beside the location name, because it is a property of the same entry.
  # It is the one thing that can say "in" when Flow's list says "out":
  # Flow rewrites custom.oos_warehouses from live inventory and keeps
  # doing so, so an override has to live somewhere Flow never writes.
  # Canada needed it first — its stock sits in GoBolt's app, so Shopify
  # sees none and the market could not open preorders.
  assign wh_current = ''
  assign wh_default = ''
  assign wh_open = false
  assign wh_default_open = false
  assign wh_mk = 'main'
  if routes.root_url != '/'
    assign wh_mk = routes.root_url | remove_first: '/' | split: '-' | last | downcase
  endif
  for wh in settings.warehouses
    assign wh_loc = wh.location.value | strip | downcase
    if wh_loc == blank
      continue
    endif
    if wh.is_default.value and wh_default == ''
      assign wh_default = wh_loc
      if wh.sell_regardless.value
        assign wh_default_open = true
      endif
    endif
    if wh.domains.value
      for wh_d in wh.domains.value
        assign wh_dd = wh_d | strip | downcase
        if wh_dd == wh_mk
          # Both are reassigned together, and wh_open is cleared first
          # rather than only ever raised. Two entries can claim one market
          # — Canada briefly had two, one made by hand and one by the rates
          # app — and the last match wins the location name. If the flag
          # merely accumulated, the location could come from one entry and
          # the permission to sell from the other: a market selling on a
          # tick belonging to a warehouse it is not reading.
          assign wh_current = wh_loc
          assign wh_open = false
          if wh.sell_regardless.value
            assign wh_open = true
          endif
        endif
      endfor
    endif
  endfor
  if wh_current == ''
    assign wh_current = wh_default
    assign wh_open = wh_default_open
  endif

  assign oos_l_ap = product.metafields.custom.oos_warehouses.value
  assign oos_l_mp = product.metafields.custom.oos_warehouses_manual.value
  if variant
    assign oos_l_av = variant.metafields.custom.oos_warehouses.value
    assign oos_l_mv = variant.metafields.custom.oos_warehouses_manual.value
  endif

  assign wh_lists_set = false
  if oos_l_ap or oos_l_mp or oos_l_av or oos_l_mv
    assign wh_lists_set = true
  endif

  # wh_all tracks the manual list's 'all' separately from an ordinary
  # warehouse match, because a market's "sell regardless" may not override
  # it: 'all' is somebody deliberately stopping sales everywhere, and a
  # per-market preorder switch is a smaller statement than that.
  assign wh_out = false
  assign wh_all = false
  if wh_lists_set
    for w in oos_l_mp
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
        assign wh_all = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_mv
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
        assign wh_all = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_ap
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_av
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
  endif

  # Product-scoped check with the lists living on the variants: out for
  # this warehouse only when every variant says so. Manual variant lists
  # honour 'all', automatic ones are exact matches — same rules as above.
  unless variant
    if wh_out == false
      assign pv_total = 0
      assign pv_out = 0
      for pv in product.variants
        assign pv_total = pv_total | plus: 1
        assign pv_l_a = pv.metafields.custom.oos_warehouses.value
        assign pv_l_m = pv.metafields.custom.oos_warehouses_manual.value
        if pv_l_a or pv_l_m
          assign wh_lists_set = true
        endif
        assign pv_is_out = false
        for w in pv_l_m
          assign wq = w | strip | downcase
          if wq == 'all'
            assign pv_is_out = true
            assign wh_all = true
          elsif wh_current != '' and wq == wh_current
            assign pv_is_out = true
          endif
        endfor
        for w in pv_l_a
          assign wq = w | strip | downcase
          if wh_current != '' and wq == wh_current
            assign pv_is_out = true
          endif
        endfor
        if pv_is_out
          assign pv_out = pv_out | plus: 1
        endif
      endfor
      if pv_total > 0 and pv_out == pv_total
        assign wh_out = true
      endif
    endif
  endunless

  # The override, applied once every list has been read. Flow keeps writing
  # custom.oos_warehouses from live inventory and this does not stop it —
  # the market simply stops listening to it. So when the goods land and the
  # tick comes off, the list is already correct and there is nothing to undo.
  if wh_open and wh_all == false
    assign wh_out = false
  endif

  assign stock_state = ''
  if wh_lists_set
    if wh_out
      assign stock_state = 'sold_out'
    elsif variant
      if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 50
        assign stock_state = 'last_few'
      endif
    elsif product != blank
      assign stock_total = 0
      assign stock_tracked = false
      for v in product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  elsif variant
    if variant.available == false
      assign stock_state = 'sold_out'
    elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 50
      assign stock_state = 'last_few'
    endif
  elsif product != blank
    if product.available == false
      assign stock_state = 'sold_out'
    else
      assign stock_total = 0
      assign stock_tracked = false
      for v in product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  endif

  echo stock_state
-%}
