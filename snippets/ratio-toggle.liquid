{% comment %}
  Visitor-facing card ratio toggle (Portrait 4:5 / Square 1:1).
  Sets data-st-ratio on <body>, which the product grid sections' CSS
  responds to page-wide; the choice persists in localStorage. Safe to
  render in several sections on one page — instances stay in sync via a
  document event and the element defines itself only once.

  Accepts:
  - default_ratio:   '4-5' (default) or '1-1' — used until the visitor chooses
  - label_portrait:  label for the 4:5 option (default "Portrait")
  - label_square:    label for the 1:1 option (default "Square")
{% endcomment %}

<style>
  .strt {
    display: flex;
    justify-content: flex-end;
    gap: 16px;
    margin: 0 0 16px;
  }
  .strt__opt {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #b8b8b8;
    cursor: pointer;
  }
  .strt__opt.is-active {
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
</style>

<st-ratio-toggle class="strt" data-default="{{ default_ratio | default: '4-5' }}">
  <button type="button" class="strt__opt" data-ratio="4-5" aria-pressed="false">{{ label_portrait | default: 'Portrait' | escape }}</button>
  <button type="button" class="strt__opt" data-ratio="1-1" aria-pressed="false">{{ label_square | default: 'Square' | escape }}</button>
</st-ratio-toggle>

<script>
  if (!customElements.get('st-ratio-toggle')) {
    customElements.define('st-ratio-toggle', class extends HTMLElement {
      connectedCallback() {
        this.btns = Array.from(this.querySelectorAll('[data-ratio]'));
        this.btns.forEach((b) => b.addEventListener('click', () => this.set(b.dataset.ratio, true)));
        this.onChange = (e) => this.paint(e.detail);
        document.addEventListener('st:ratio', this.onChange);
        let saved = null;
        try { saved = localStorage.getItem('st:ratio'); } catch (e) {}
        this.set(saved || this.dataset.default || '4-5', false);
      }

      disconnectedCallback() {
        document.removeEventListener('st:ratio', this.onChange);
      }

      set(ratio, save) {
        document.body.setAttribute('data-st-ratio', ratio);
        if (save) { try { localStorage.setItem('st:ratio', ratio); } catch (e) {} }
        document.dispatchEvent(new CustomEvent('st:ratio', { detail: ratio }));
      }

      paint(ratio) {
        this.btns.forEach((b) => {
          const active = b.dataset.ratio === ratio;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      }
    });
  }
</script>
