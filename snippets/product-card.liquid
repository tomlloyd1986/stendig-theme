{% comment %}
    Renders a product card

    Accepts:
    - product_card_product: {Object} Product Liquid object (optional)
    - media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
    - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
    - add_image_padding: {Boolean} Enables padding on the image to space out the grid
    - show_vendor: {Boolean} Show the product vendor. Default: false
    - show_image_outline: {Boolean} Show card outline. Default: true (optional)
    - show_rating: {Boolean} Show the product rating. Default: false

    Usage:
    {% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Optional curation overrides (used by the 2026 Collection section):
  - card_variant: render a specific variant's image / link / colour title
  - card_title:   override the displayed title
  Defaults keep normal product behaviour for every existing caller.
{%- endcomment -%}
{%- liquid
  assign pcp_image = product_card_product.featured_media
  assign pcp_url = product_card_product.url
  assign pcp_title = product_card_product.title
  if card_variant
    if card_variant.image
      assign pcp_image = card_variant.image
    endif
    assign pcp_url = product_card_product.url | append: '?variant=' | append: card_variant.id
  endif
  if card_title
    assign pcp_title = card_title
  endif

  # Stock state pill: 'sold_out' (red dot) beats 'last_few' (orange dot).
  # Availability prefers the warehouse metafields — custom.oos_warehouses /
  # _manual on product and variant, the same source the product page's
  # waitlist logic uses — resolved for the warehouse serving this market's
  # subfolder ('/en-au' -> 'au'; root domain -> 'main'). When no metafield
  # is set, Shopify's native availability decides. 'Last few' uses the
  # global tracked quantity (per-warehouse counts aren't exposed to
  # Liquid) and only shows when the warehouse says available.

  assign wh_current = ''
  assign wh_default = ''
  assign wh_mk = 'main'
  if routes.root_url != '/'
    assign wh_mk = routes.root_url | remove_first: '/' | split: '-' | last | downcase
  endif
  for wh in settings.warehouses
    assign wh_loc = wh.location.value | strip | downcase
    if wh_loc == blank
      continue
    endif
    if wh.is_default.value and wh_default == ''
      assign wh_default = wh_loc
    endif
    if wh.domains.value
      for wh_d in wh.domains.value
        assign wh_dd = wh_d | strip | downcase
        if wh_dd == wh_mk
          assign wh_current = wh_loc
        endif
      endfor
    endif
  endfor
  if wh_current == ''
    assign wh_current = wh_default
  endif

  assign oos_l_ap = product_card_product.metafields.custom.oos_warehouses.value
  assign oos_l_mp = product_card_product.metafields.custom.oos_warehouses_manual.value
  if card_variant
    assign oos_l_av = card_variant.metafields.custom.oos_warehouses.value
    assign oos_l_mv = card_variant.metafields.custom.oos_warehouses_manual.value
  endif

  assign wh_lists_set = false
  if oos_l_ap or oos_l_mp or oos_l_av or oos_l_mv
    assign wh_lists_set = true
  endif

  assign wh_out = false
  if wh_lists_set
    for w in oos_l_mp
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_mv
      assign wq = w | strip | downcase
      if wq == 'all'
        assign wh_out = true
      elsif wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_ap
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
    for w in oos_l_av
      assign wq = w | strip | downcase
      if wh_current != '' and wq == wh_current
        assign wh_out = true
      endif
    endfor
  endif

  assign stock_state = ''
  if wh_lists_set
    if wh_out
      assign stock_state = 'sold_out'
    elsif card_variant
      if card_variant.inventory_management == 'shopify' and card_variant.inventory_policy == 'deny' and card_variant.inventory_quantity > 0 and card_variant.inventory_quantity <= 50
        assign stock_state = 'last_few'
      endif
    elsif product_card_product != blank
      assign stock_total = 0
      assign stock_tracked = false
      for v in product_card_product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  elsif card_variant
    if card_variant.available == false
      assign stock_state = 'sold_out'
    elsif card_variant.inventory_management == 'shopify' and card_variant.inventory_policy == 'deny' and card_variant.inventory_quantity > 0 and card_variant.inventory_quantity <= 50
      assign stock_state = 'last_few'
    endif
  elsif product_card_product != blank
    if product_card_product.available == false
      assign stock_state = 'sold_out'
    else
      assign stock_total = 0
      assign stock_tracked = false
      for v in product_card_product.variants
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
          assign stock_tracked = true
          if v.inventory_quantity > 0
            assign stock_total = stock_total | plus: v.inventory_quantity
          endif
        endif
      endfor
      if stock_tracked and stock_total > 0 and stock_total <= 50
        assign stock_state = 'last_few'
      endif
    endif
  endif
-%}

<div class="card-wrapper">
  <div class="card-information">
    <div class="card-information__wrapper">
      {%- if show_vendor -%}
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <div class="caption-with-letter-spacing light">{{ product_card_product.vendor }}</div>
      {%- endif -%}

      {%- if pcp_image -%}
        <h3 class="card-information__text h5">
          <a href="{{ pcp_url | default: '#' }}" class="full-unstyled-link">
            {{ pcp_title | escape }}
            {%- if stock_state == 'sold_out' -%}
              <span class="visually-hidden"> &mdash; {{ 'products.product.stock_sold_out' | t }}</span>
            {%- elsif stock_state == 'last_few' -%}
              <span class="visually-hidden"> &mdash; {{ 'products.product.stock_last_few' | t }}</span>
            {%- endif -%}
          </a>
        </h3>
      {%- endif -%}

      {%- if show_rating and product_card_product.metafields.reviews.rating.value != blank -%}
        {% liquid
          assign rating_decimal = 0 
          assign decimal = product_card_product.metafields.reviews.rating.value.rating | modulo: 1 
          if decimal >= 0.3 and decimal <= 0.7
            assign rating_decimal = 0.5
          elsif decimal > 0.7
            assign rating_decimal = 1
          endif 
        %}
        <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product_card_product.metafields.reviews.rating.value, rating_max: product_card_product.metafields.reviews.rating.value.scale_max }}">
          <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ product_card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product_card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
        </div>
        <p class="rating-text caption">
          <span aria-hidden="true">{{ product_card_product.metafields.reviews.rating.value }} / {{ product_card_product.metafields.reviews.rating.value.scale_max }}</span>
        </p>
        <p class="rating-count caption">
          <span aria-hidden="true">({{ product_card_product.metafields.reviews.rating_count }})</span>
          <span class="visually-hidden">{{ product_card_product.metafields.reviews.rating_count }} {{ "accessibility.total_reviews" | t }}</span>
        </p>
      {%- endif -%}
      {% render 'price', product: product_card_product, price_class: '' %}
    </div>
  </div>

  <div class="card card--product{% if pcp_image == nil %} card--text-only card--soft{% endif %}{% if pcp_image != nil and show_image_outline %} card--outline{% endif %}" tabindex="-1">
    <div class="card__inner">
      {%- if pcp_image -%}
        {%- liquid
          assign featured_media_aspect_ratio = pcp_image.aspect_ratio

          if pcp_image.aspect_ratio == nil
            assign featured_media_aspect_ratio = 1
          endif
        -%}

        <div{% if add_image_padding %} class="card__media-full-spacer"{% endif %}>
          <div class="media media--transparent media--{{ media_size }} media--hover-effect"
            {% if media_size == 'adapt' and pcp_image %} style="padding-bottom: {{ 1 | divided_by: featured_media_aspect_ratio | times: 100 }}%;"{% endif %}
          >
            {%- if stock_state != blank -%}
              <span class="st-stock-pill st-stock-pill--{{ stock_state }}" aria-hidden="true">
                <span class="st-stock-pill__dot"></span>
                {%- if stock_state == 'sold_out' -%}{{ 'products.product.stock_sold_out' | t }}{%- else -%}{{ 'products.product.stock_last_few' | t }}{%- endif -%}
              </span>
            {%- endif -%}
            {%- liquid
              # First row of a collection grid loads eagerly so the LCP image
              # isn't deferred; the very first also gets high fetch priority.
              assign card_img_loading = 'lazy'
              if card_index and card_index <= 4
                assign card_img_loading = 'eager'
              endif
            -%}
            <img
              srcset="{%- if pcp_image.width >= 165 -%}{{ pcp_image | img_url: '165x' }} 165w,{%- endif -%}
                {%- if pcp_image.width >= 360 -%}{{ pcp_image | img_url: '360x' }} 360w,{%- endif -%}
                {%- if pcp_image.width >= 533 -%}{{ pcp_image | img_url: '533x' }} 533w,{%- endif -%}
                {%- if pcp_image.width >= 720 -%}{{ pcp_image | img_url: '720x' }} 720w,{%- endif -%}
                {%- if pcp_image.width >= 940 -%}{{ pcp_image | img_url: '940x' }} 940w,{%- endif -%}
                {%- if pcp_image.width >= 1066 -%}{{ pcp_image | img_url: '1066x' }} 1066w,{%- endif -%}
                {{ pcp_image | img_url: 'master' }} {{ pcp_image.width }}w"
              src="{{ pcp_image | img_url: '533x' }}"
              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
              alt="{{ pcp_image.alt | escape }}"
              loading="{{ card_img_loading }}"
              {% if card_index == 1 %}fetchpriority="high"{% endif %}
              class="motion-reduce"
              width="{{ pcp_image.width }}"
              height="{{ pcp_image.height }}"
            >

            {%- if product_card_product.media[1] != nil and show_secondary_image -%}
              <img
                srcset="{%- if product_card_product.media[1].width >= 165 -%}{{ product_card_product.media[1] | img_url: '165x' }} 165w,{%- endif -%}
                  {%- if product_card_product.media[1].width >= 360 -%}{{ product_card_product.media[1] | img_url: '360x' }} 360w,{%- endif -%}
                  {%- if product_card_product.media[1].width >= 533 -%}{{ product_card_product.media[1] | img_url: '533x' }} 533w,{%- endif -%}
                  {%- if product_card_product.media[1].width >= 720 -%}{{ product_card_product.media[1] | img_url: '720x' }} 720w,{%- endif -%}
                  {%- if product_card_product.media[1].width >= 940 -%}{{ product_card_product.media[1] | img_url: '940x' }} 940w,{%- endif -%}
                  {%- if product_card_product.media[1].width >= 1066 -%}{{ product_card_product.media[1] | img_url: '1066x' }} 1066w,{%- endif -%}
                  {{ product_card_product.media[1] | img_url: 'master' }} {{ product_card_product.media[1].width }}w"
                src="{{ product_card_product.media[1] | img_url: '533x' }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                alt="{{ product_card_product.media[1].alt | escape }}"
                loading="lazy"
                fetchpriority="low"
                class="motion-reduce"
              width="{{ product_card_product.media[1].width }}"
              height="{{ product_card_product.media[1].height }}"
              >
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="card__content">
          <h2 class="card__text h3">
            <a href="{{ pcp_url | default: '#' }}" class="full-unstyled-link">
              {{ pcp_title }}
            </a>
          </h2>
        </div>
      {%- endif -%}

      {%- comment -%} Sold out is handled by the stock pill; only the sale badge remains here {%- endcomment -%}
      <div class="card__badge">
        {%- if product_card_product.compare_at_price > product_card_product.price and product_card_product.available -%}
          <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
