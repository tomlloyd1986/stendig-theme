{% comment %}
  Outputs the text "true" when the variant is purchasable in the given
  warehouse — the server-side mirror of window.warehouseAvailability.

  Accepts:
  - variant: {Object} the variant to check
  - parent: {Object} the variant's product
  - current_wh: {String} current warehouse location name, lowercased ('' = none)
  - wh_open: {Boolean} optional; the warehouse entry's "Sell regardless of
    stock" is ticked, so this market ignores the out-of-stock lists

  Merges custom.oos_warehouses (Flow-maintained) and
  custom.oos_warehouses_manual (human-edited, may contain "all") from both
  product and variant. When no metafield is set, falls back to the
  variant's native availability.

  wh_open answers only the warehouse match, never "all": Flow keeps writing
  the automatic list from live inventory, so a market opening preorders has
  to overrule it, but "all" is a person deliberately stopping sales
  everywhere and outranks a per-market switch.

  The admin's custom.sell_regardless_warehouses opens this product in one
  market the way wh_open opens a whole one; custom.stop_selling_warehouses
  closes it once that market's orders reach the admin's stock, and outranks
  every opening. Both read from product and variant, as stock-state does.
{% endcomment %}

{%- liquid
  assign has_meta = false
  assign oos_str = '||'

  if parent.metafields.custom.oos_warehouses.value
    assign has_meta = true
    for w in parent.metafields.custom.oos_warehouses.value
      assign w_clean = w | strip | downcase
      assign oos_str = oos_str | append: w_clean | append: '||'
    endfor
  endif

  if parent.metafields.custom.oos_warehouses_manual.value
    assign has_meta = true
    for w in parent.metafields.custom.oos_warehouses_manual.value
      assign w_clean = w | strip | downcase
      assign oos_str = oos_str | append: w_clean | append: '||'
    endfor
  endif

  if variant.metafields.custom.oos_warehouses.value
    assign has_meta = true
    for w in variant.metafields.custom.oos_warehouses.value
      assign w_clean = w | strip | downcase
      assign oos_str = oos_str | append: w_clean | append: '||'
    endfor
  endif

  if variant.metafields.custom.oos_warehouses_manual.value
    assign has_meta = true
    for w in variant.metafields.custom.oos_warehouses_manual.value
      assign w_clean = w | strip | downcase
      assign oos_str = oos_str | append: w_clean | append: '||'
    endfor
  endif

  assign sel_open = '||'
  assign sel_stop = '||'
  for w in parent.metafields.custom.sell_regardless_warehouses.value
    assign w_clean = w | strip | downcase
    assign sel_open = sel_open | append: w_clean | append: '||'
  endfor
  for w in variant.metafields.custom.sell_regardless_warehouses.value
    assign w_clean = w | strip | downcase
    assign sel_open = sel_open | append: w_clean | append: '||'
  endfor
  for w in parent.metafields.custom.stop_selling_warehouses.value
    assign w_clean = w | strip | downcase
    assign sel_stop = sel_stop | append: w_clean | append: '||'
  endfor
  for w in variant.metafields.custom.stop_selling_warehouses.value
    assign w_clean = w | strip | downcase
    assign sel_stop = sel_stop | append: w_clean | append: '||'
  endfor
  assign wh_needle = '||' | append: current_wh | append: '||'
  assign sel_opened = false
  assign sel_stopped = false
  if current_wh != ''
    if sel_open contains wh_needle
      assign sel_opened = true
    endif
    if sel_stop contains wh_needle
      assign sel_stopped = true
    endif
  endif

  if sel_stopped
    echo ''
  elsif has_meta and current_wh != ''
    if oos_str contains '||all||'
      echo ''
    elsif wh_open or sel_opened
      echo 'true'
    elsif oos_str contains wh_needle
      echo ''
    else
      echo 'true'
    endif
  elsif sel_opened
    echo 'true'
  elsif has_meta
    if oos_str contains '||all||'
      echo ''
    else
      echo 'true'
    endif
  elsif variant.available
    echo 'true'
  endif
-%}
