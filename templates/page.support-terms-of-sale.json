        "question_tawCkr": {
          "type": "question",
          "settings": {
            "question": "Delivery",
            "answer": "<p>Estimated delivery times and charges are shown at checkout and on our Shipping Policy page. Estimates are not guaranteed, but if delivery is delayed by an event outside our control we will let you know and take reasonable steps to minimise the delay.</p><p>The products become your responsibility from the moment they are delivered to the address you gave us. Ownership passes to you once we have received payment in full.</p><p>If nobody is available to receive the delivery and the products are returned to us, we may charge the reasonable costs of redelivery, or cancel the order and refund you less our reasonable costs.</p><h2></h2>"
          }
