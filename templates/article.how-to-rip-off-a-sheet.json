        "text_DCifJN": {
          "type": "text",
          "settings": {
            "heading": "",
            "body": "<p>Stendig sheets have a 40 teeth per inch perforation that runs perpendicular to the top of the sheet, two inches down. It's calibrated to achieve the perfect balance between ease of removal and durability.</p><p>Once removed, detached sheets make for excellent wrapping paper. Store them rolled up to avoid creasing.</p>"
          }
        },
