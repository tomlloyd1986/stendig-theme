{% comment %}
  Blog: Step by step — the four-photo sheet-removal guide (option 1a of
  the handoff), built as a reusable section for blog/article pages. It
  sits below the embedded video on "How to remove a sheet" but can be
  added to any article or page.

  Anatomy is the theme's signature opener — hairline divider, 14px gap,
  sentence-case eyebrow — then an 80px gap (40px mobile) into a 4-across
  photo grid (2x2 on tablet and mobile). Each step: 4:5 photo, "1."
  number, muted caption. No hover states, no JS.

  The four client photographs ship in the theme's assets as defaults;
  the image pickers override them per use. Type and spacing locked.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .rip {
    max-width: var(--st-page-max, 1440px);
    margin: 0 auto;
    padding: 0 20px 80px;
  }
  #shopify-section-{{ section.id }} .rip__divider {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .rip__eyebrow {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 14px 0 0;
  }
  #shopify-section-{{ section.id }} .rip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 80px;
  }
  #shopify-section-{{ section.id }} .rip__step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .rip__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    background: #f3f3f3;
  }
  #shopify-section-{{ section.id }} .rip__num {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .rip__caption {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    /* net 4px under the number: cell gap 12px minus 8px */
    margin: -8px 0 0;
    text-wrap: pretty;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .rip__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 10px;
    }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .rip { padding: 0 12px 80px; }
    #shopify-section-{{ section.id }} .rip__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 10px;
      margin-top: 40px;
    }
    #shopify-section-{{ section.id }} .rip__step { gap: 10px; }
    #shopify-section-{{ section.id }} .rip__caption { margin-top: -6px; }
  }
{% endstyle %}

<div class="rip">
  <hr class="rip__divider">
  {%- if section.settings.eyebrow != blank -%}
    <p class="rip__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}

  <div class="rip__grid">
    {%- for i in (1..4) -%}
      {%- liquid
        assign image_key = 'image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign step_image = section.settings[image_key]
        assign step_caption = section.settings[caption_key]
        assign fallback = 'rip-step-' | append: i | append: '.jpg'
      -%}
      <div class="rip__step">
        {%- if step_image != blank -%}
          <img
            class="rip__photo"
            src="{{ step_image | image_url: width: 720 }}"
            srcset="{{ step_image | image_url: width: 360 }} 360w, {{ step_image | image_url: width: 540 }} 540w, {{ step_image | image_url: width: 720 }} 720w"
            sizes="(max-width: 989px) calc((100vw - 34px) / 2), 350px"
            width="{{ step_image.width }}"
            height="{{ step_image.height }}"
            alt="{{ step_image.alt | default: step_caption | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            class="rip__photo"
            src="{{ fallback | asset_url }}"
            width="1000"
            height="1200"
            alt="{{ step_caption | escape }}"
            loading="lazy"
          >
        {%- endif -%}
        <p class="rip__num">{{ i }}.</p>
        {%- if step_caption != blank -%}
          <p class="rip__caption">{{ step_caption }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog: Step by step",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Step by step" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1", "info": "All photos display at 4:5. Leave empty to use the built-in sheet-removal photos." },
    { "type": "textarea", "id": "caption_1", "label": "Caption 1", "default": "Find the perforation hidden beneath the header and start a small tear, 1 cm / ½″ long." },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "textarea", "id": "caption_2", "label": "Caption 2", "default": "Hold the header steady with one hand. Don’t tear sideways along the perforation — it won’t rip cleanly." },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "textarea", "id": "caption_3", "label": "Caption 3", "default": "Grip the bottom of the sheet, below the rip, and pull straight down." },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4" },
    { "type": "textarea", "id": "caption_4", "label": "Caption 4", "default": "Keep it taut as it separates. Detached sheets make great wrapping paper." }
  ],
  "enabled_on": { "templates": ["article", "page"] },
  "presets": [{ "name": "Blog: Step by step" }]
}
{% endschema %}
