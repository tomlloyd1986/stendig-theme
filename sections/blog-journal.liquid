{% comment %}
  Blog: Journal — the journal listing as one continuous three-column
  mosaic (option 2b of the redesign handoff). No hero story: every
  article is a card with its featured image at a natural-ish ratio
  (bucketed to 4:5, 1:1 or 3:4 — never a forced landscape crop), the
  category label (first tag), title, excerpt and date. No read times.

  Pinned articles sort to the front of the mosaic and carry a plain
  "Pinned · Category" label. Pin an article by ticking the
  journal.pinned metafield, or simply by giving it the tag "pinned"
  (the tag is not shown as a category). With nothing pinned the page is
  a plain newest-first mosaic with no visual difference.

  Pinned-first ordering is applied within each page of results; the
  page size is generous (24) so in practice everything sorts together.
  Content comes from real blog articles; type and spacing locked.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .jrn {
    max-width: 1120px;
    margin: 0 auto;
    padding: 60px 20px 80px;
  }
  #shopify-section-{{ section.id }} .jrn__title {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .jrn__standfirst {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    max-width: 520px;
    margin: 12px 0 0;
  }
  #shopify-section-{{ section.id }} .jrn__rule {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 40px 0;
  }

  /* Mosaic: CSS columns so mixed image ratios pack naturally */
  #shopify-section-{{ section.id }} .jrn__mosaic {
    column-count: 3;
    column-gap: 20px;
  }
  #shopify-section-{{ section.id }} .jrn__story {
    display: flex;
    flex-direction: column;
    break-inside: avoid;
    margin: 0 0 56px;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .jrn__media {
    position: relative;
    background: #f3f3f3;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .jrn__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .jrn__media--r45 { aspect-ratio: 4 / 5; }
  #shopify-section-{{ section.id }} .jrn__media--r11 { aspect-ratio: 1 / 1; }
  #shopify-section-{{ section.id }} .jrn__media--r34 { aspect-ratio: 3 / 4; }

  #shopify-section-{{ section.id }} .jrn__label {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.55);
    margin: 14px 0 0;
  }
  #shopify-section-{{ section.id }} .jrn__label .jrn__pin { color: #121212; }
  #shopify-section-{{ section.id }} .jrn__story-title {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 4px 0 0;
  }
  #shopify-section-{{ section.id }} .jrn__story:hover .jrn__story-title {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  #shopify-section-{{ section.id }} .jrn__excerpt {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 4px 0 0;
  }
  #shopify-section-{{ section.id }} .jrn__date {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 8px 0 0;
  }

  /* Pagination (kept from the previous journal) */
  #shopify-section-{{ section.id }} .jrn__pages {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .jrn__page,
  #shopify-section-{{ section.id }} .jrn__older {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .jrn__page--current {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  #shopify-section-{{ section.id }} a.jrn__page:hover,
  #shopify-section-{{ section.id }} .jrn__older:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  #shopify-section-{{ section.id }} .jrn__older { margin-left: auto; }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .jrn__mosaic { column-count: 2; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .jrn { padding: 40px 12px 60px; }
    #shopify-section-{{ section.id }} .jrn__title { font-size: 26px; }
    #shopify-section-{{ section.id }} .jrn__mosaic { column-count: 1; }
  }
{% endstyle %}

{%- paginate blog.articles by 24 -%}
<div class="jrn">
  <h1 class="jrn__title">{{ section.settings.heading | default: blog.title | escape }}</h1>
  {%- if section.settings.standfirst != blank -%}
    <p class="jrn__standfirst">{{ section.settings.standfirst | escape }}</p>
  {%- endif -%}
  <hr class="jrn__rule">

  <div class="jrn__mosaic">
    {%- comment -%} Two passes over the page's articles: pinned first {%- endcomment -%}
    {%- for pass in (1..2) -%}
      {%- for article in blog.articles -%}
        {%- liquid
          assign is_pinned = false
          if article.metafields.journal.pinned.value == true or article.tags contains 'pinned' or article.tags contains 'Pinned'
            assign is_pinned = true
          endif
          if pass == 1 and is_pinned != true
            continue
          endif
          if pass == 2 and is_pinned
            continue
          endif

          # Category = first tag that is not the pin flag itself
          assign category = ''
          for tag in article.tags
            assign tag_down = tag | downcase
            if tag_down == 'pinned'
              continue
            endif
            assign category = tag
            break
          endfor

          # Bucket the featured image's natural shape: portrait leans to
          # 3:4 or 4:5; square and landscape render 1:1 (never 16:9)
          assign ratio_class = 'jrn__media--r11'
          if article.image
            if article.image.aspect_ratio < 0.775
              assign ratio_class = 'jrn__media--r34'
            elsif article.image.aspect_ratio < 0.9
              assign ratio_class = 'jrn__media--r45'
            endif
          endif
        -%}
        <a class="jrn__story" href="{{ article.url }}">
          <div class="jrn__media {{ ratio_class }}">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 720 }}"
                srcset="{{ article.image | image_url: width: 360 }} 360w, {{ article.image | image_url: width: 540 }} 540w, {{ article.image | image_url: width: 720 }} 720w, {{ article.image | image_url: width: 1080 }} 1080w"
                sizes="(max-width: 749px) calc(100vw - 24px), (max-width: 989px) calc((100vw - 60px) / 2), 360px"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          {%- if is_pinned or category != '' -%}
            <p class="jrn__label">
              {%- if is_pinned -%}
                <span class="jrn__pin">{{ section.settings.pinned_label | default: 'Pinned' | escape }}</span>
                {%- if category != '' %} &middot; {{ category | escape }}{% endif -%}
              {%- else -%}
                {{ category | escape }}
              {%- endif -%}
            </p>
          {%- endif -%}
          <h3 class="jrn__story-title">{{ article.title | escape }}</h3>
          <p class="jrn__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
          <p class="jrn__date">{{ article.published_at | date: '%B %-d, %Y' }}</p>
        </a>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    {%- assign current_str = paginate.current_page | append: '' -%}
    <nav role="navigation" aria-label="Pagination">
      <hr class="jrn__rule">
      <div class="jrn__pages">
        {%- for part in paginate.parts -%}
          {%- assign part_str = part.title | append: '' -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="jrn__page">{{ part.title }}</a>
          {%- elsif part_str == current_str -%}
            <span class="jrn__page jrn__page--current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="jrn__page">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="jrn__older">{{ section.settings.older_label | default: 'Older articles' | escape }} &rarr;</a>
        {%- endif -%}
      </div>
    </nav>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog: Journal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal", "info": "Falls back to the blog's title when empty." },
    { "type": "text", "id": "standfirst", "label": "Intro line", "default": "Notes on the calendar, the people who made it, and how to live with one." },
    { "type": "text", "id": "pinned_label", "label": "Pinned label", "default": "Pinned" },
    { "type": "text", "id": "older_label", "label": "Older articles label", "default": "Older articles", "info": "Shown in the pagination row when there are more pages. The arrow is added automatically." },
    { "type": "paragraph", "content": "Pin an article to the front of the mosaic by tagging it \"pinned\" (or ticking its journal.pinned metafield). The label above each title is the article's first other tag; excerpts come from the article's excerpt or its opening text; images use the article's featured image at its natural shape." }
  ],
  "enabled_on": { "templates": ["blog"] },
  "presets": [{ "name": "Blog: Journal" }]
}
{% endschema %}
