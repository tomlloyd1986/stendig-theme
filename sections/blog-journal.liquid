{% comment %}
  Blog: Journal — the blog index page, built to the Claude Design handoff
  ("Stendig Journal"). Anatomy, top to bottom:
    page header (H1 + muted intro line, 640px, left-aligned — no divider
    or eyebrow opener on this page; that's deliberate in the design)
    featured post: 7/5 grid, 16:9 image | category, title, excerpt, link
    hairline divider
    3-across card grid (2-up tablet and mobile), 4:5 images
    pagination: divider, page numbers, "Older articles →"
  Driven by real blog articles: the newest article is featured on page 1;
  the category label is the article's first tag; excerpts come from the
  article's excerpt (or its opening text). 7 posts per page — 1 featured
  + 6 grid (two clean rows of three) — locked to keep the rhythm.
  Editable: heading, intro, older-articles label. Layout, type and
  spacing locked.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .jrn {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px 80px;
    box-sizing: border-box;
    color: #121212;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .jrn__intro {
    max-width: 640px;
    margin: 0 0 60px;
  }
  #shopify-section-{{ section.id }} .jrn__title {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .jrn__standfirst {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 16px 0 0;
    text-wrap: pretty;
  }

  /* Image frames: fixed ratio, clipped, 1.05 zoom on hover */
  #shopify-section-{{ section.id }} .jrn__media {
    display: block;
    overflow: hidden;
    background: #f3f3f3;
  }
  #shopify-section-{{ section.id }} .jrn__media img,
  #shopify-section-{{ section.id }} .jrn__media .jrn__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} a.jrn__media:hover img { transform: scale(1.05); }
  #shopify-section-{{ section.id }} .jrn__media--wide { aspect-ratio: 16 / 9; }
  #shopify-section-{{ section.id }} .jrn__media--card { aspect-ratio: 4 / 5; }

  #shopify-section-{{ section.id }} .jrn__cat {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.55);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .jrn__titlelink {
    display: block;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .jrn__titlelink:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
    color: #000;
  }

  /* Featured post */
  #shopify-section-{{ section.id }} .jrn__feat {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 80px;
  }
  #shopify-section-{{ section.id }} .jrn__feat-title {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .jrn__feat .jrn__titlelink { margin: 16px 0 20px; }
  #shopify-section-{{ section.id }} .jrn__feat-excerpt {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 0 0 20px;
    text-wrap: pretty;
  }
  #shopify-section-{{ section.id }} .jrn__read {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  #shopify-section-{{ section.id }} .jrn__divider {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 0 0 40px;
  }

  /* Post grid */
  #shopify-section-{{ section.id }} .jrn__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 10px;
  }
  #shopify-section-{{ section.id }} .jrn__card-text { margin-top: 20px; }
  #shopify-section-{{ section.id }} .jrn__card .jrn__titlelink { margin: 10px 0 12px; }
  #shopify-section-{{ section.id }} .jrn__card-title {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 20px;
    line-height: 26px;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .jrn__card-excerpt {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 0;
    text-wrap: pretty;
  }

  /* Pagination */
  #shopify-section-{{ section.id }} .jrn__pagination { margin-top: 80px; }
  #shopify-section-{{ section.id }} .jrn__pagination .jrn__divider { margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .jrn__pages {
    display: flex;
    gap: 24px;
    align-items: baseline;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .jrn__page {
    color: rgba(18, 18, 18, 0.55);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .jrn__page--current {
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  #shopify-section-{{ section.id }} .jrn__older {
    margin-left: auto;
    color: #121212;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .jrn__older:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Tablet */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .jrn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 20px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .jrn { padding: 40px 12px 80px; }
    #shopify-section-{{ section.id }} .jrn__feat {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-bottom: 60px;
    }
    #shopify-section-{{ section.id }} .jrn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 10px;
    }
    #shopify-section-{{ section.id }} .jrn__card-title { font-size: 18px; line-height: 24px; }
  }
{% endstyle %}

{%- paginate blog.articles by 7 -%}
<div class="jrn">
  <div class="jrn__intro">
    <h1 class="jrn__title">{{ section.settings.heading | default: blog.title | escape }}</h1>
    {%- if section.settings.standfirst != blank -%}
      <p class="jrn__standfirst">{{ section.settings.standfirst | escape }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    # Newest article is featured, on the first page only; later pages are
    # all grid.
    assign show_featured = false
    if paginate.current_page == 1 and blog.articles.size > 0
      assign show_featured = true
    endif
  -%}

  {%- if show_featured -%}
    {%- assign featured = blog.articles.first -%}
    <div class="jrn__feat">
      <a href="{{ featured.url }}" class="jrn__media jrn__media--wide" aria-label="{{ featured.title | escape }}" tabindex="-1">
        {%- if featured.image -%}
          <img
            src="{{ featured.image | image_url: width: 1100 }}"
            srcset="{{ featured.image | image_url: width: 550 }} 550w, {{ featured.image | image_url: width: 825 }} 825w, {{ featured.image | image_url: width: 1100 }} 1100w, {{ featured.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 750px) 660px, 100vw"
            width="{{ featured.image.width }}"
            height="{{ featured.image.height }}"
            alt="{{ featured.image.alt | default: featured.title | escape }}"
            fetchpriority="high"
          >
        {%- else -%}
          <span class="jrn__placeholder" role="presentation"></span>
        {%- endif -%}
      </a>
      <div>
        {%- if featured.tags.size > 0 -%}
          <p class="jrn__cat">{{ featured.tags.first | escape }}</p>
        {%- endif -%}
        <a href="{{ featured.url }}" class="jrn__titlelink">
          <h2 class="jrn__feat-title">{{ featured.title | escape }}</h2>
        </a>
        <p class="jrn__feat-excerpt">{{ featured.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
        <a href="{{ featured.url }}" class="jrn__read">{{ section.settings.read_label | default: 'Read the article' | escape }}</a>
      </div>
    </div>

    <hr class="jrn__divider">
  {%- endif -%}

  <div class="jrn__grid">
    {%- for article in blog.articles -%}
      {%- if show_featured and forloop.first -%}{%- continue -%}{%- endif -%}
      <div class="jrn__card">
        <a href="{{ article.url }}" class="jrn__media jrn__media--card" aria-label="{{ article.title | escape }}" tabindex="-1">
          {%- if article.image -%}
            <img
              src="{{ article.image | image_url: width: 800 }}"
              srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 800 }} 800w"
              sizes="(min-width: 990px) 394px, 50vw"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              alt="{{ article.image.alt | default: article.title | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <span class="jrn__placeholder" role="presentation"></span>
          {%- endif -%}
        </a>
        <div class="jrn__card-text">
          {%- if article.tags.size > 0 -%}
            <p class="jrn__cat">{{ article.tags.first | escape }}</p>
          {%- endif -%}
          <a href="{{ article.url }}" class="jrn__titlelink">
            <h3 class="jrn__card-title">{{ article.title | escape }}</h3>
          </a>
          <p class="jrn__card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    {%- assign current_str = paginate.current_page | append: '' -%}
    <nav class="jrn__pagination" role="navigation" aria-label="Pagination">
      <hr class="jrn__divider">
      <div class="jrn__pages">
        {%- for part in paginate.parts -%}
          {%- assign part_str = part.title | append: '' -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="jrn__page">{{ part.title }}</a>
          {%- elsif part_str == current_str -%}
            <span class="jrn__page jrn__page--current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="jrn__page">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="jrn__older">{{ section.settings.older_label | default: 'Older articles' | escape }} &rarr;</a>
        {%- endif -%}
      </div>
    </nav>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog: Journal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal", "info": "Falls back to the blog's title when empty." },
    { "type": "text", "id": "standfirst", "label": "Intro line", "default": "Notes on the calendar, the people who made it, and how to live with one." },
    { "type": "text", "id": "read_label", "label": "Featured post link label", "default": "Read the article" },
    { "type": "text", "id": "older_label", "label": "Older articles label", "default": "Older articles", "info": "Shown in the pagination row when there are more pages. The arrow is added automatically." },
    { "type": "paragraph", "content": "The newest article appears as the featured post on the first page. The label above each title is the article's first tag (e.g. History, How to). Excerpts come from the article's excerpt, or its opening text when no excerpt is set." }
  ],
  "enabled_on": { "templates": ["blog"] },
  "presets": [{ "name": "Blog: Journal" }]
}
{% endschema %}
