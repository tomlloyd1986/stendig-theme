{% comment %}
  Editorial content (file kept as blog-content for existing templates) —
  the shared editorial block stack, used on blog articles and below the
  product info on product pages (Avant Arte structure, the site's own
  type system):
    Text    — rich text in a centred 512px reading column, with an
              optional Display heading above ("Space and scale")
    Quote   — display-scale centred pull quote (curly quotes added)
    Images  — 1 to 4 images in a row, at Standard (840px), Wide (1200px)
              or Ultrawide (full width within the page gutters), with an
              optional caption
    Product — small bordered product card (image, title, price/sold out)
              linking to the product
    Video   — Shopify-hosted upload or YouTube/Vimeo URL, same three
              widths, optional caption and autoplay loop; eight optional
              language-override slots swap in a different video for the
              storefront languages each one lists
  Widths, type and spacing are locked; only content is editable.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .blogc {
    padding: 0 20px 80px;
    max-width: var(--st-page-max, 1440px);
    margin-left: auto;
    margin-right: auto;
  }
  /* 512px ≈ 73 characters per line at 14px — the Avant Arte reading
     measure (their column is 512px at larger type). */
  #shopify-section-{{ section.id }} .blogc__w-body { max-width: 512px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-standard { max-width: 760px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-wide { max-width: 1040px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-ultrawide { max-width: none; }

  /* Text */
  #shopify-section-{{ section.id }} .blogc__heading {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  #shopify-section-{{ section.id }} .blogc__text {
    margin-bottom: 28px;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
  }
  #shopify-section-{{ section.id }} .blogc__text p { margin: 0 0 21px; }
  #shopify-section-{{ section.id }} .blogc__text p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .blogc__text a {
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  #shopify-section-{{ section.id }} .blogc__text strong { font-weight: 700; }

  /* Quote */
  #shopify-section-{{ section.id }} .blogc__quotewrap {
    /* Clearly wider than the 512px reading column, per the handoff's
       original quote width — the quote should break the column */
    max-width: 680px;
    /* Equal top and bottom. The top margin collapses against the bottom
       margin of whatever block precedes it (text 28px, media/product
       48px), so it has to be the larger of the pair to survive — hence
       matching 72px rather than a smaller top value. */
    margin: 72px auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .blogc__quote {
    /* Reset Dawn's base blockquote (italic, grey, left border, padding) */
    margin: 0;
    padding: 0;
    border: none;
    font-style: normal;
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 30px;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-wrap: pretty;
  }
  #shopify-section-{{ section.id }} .blogc__quote-attr {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 12px 0 0;
  }

  /* Images / video */
  #shopify-section-{{ section.id }} .blogc__media {
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .blogc__media-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .blogc__media-row > div {
    flex: 1 1 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .blogc__media img,
  #shopify-section-{{ section.id }} .blogc__media video {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The frame takes the video's own shape. A portrait video in a 16:9
     frame is letterboxed by the player: the frame is full width but the
     picture shrinks to fit the height, so it ends up a narrow strip. */
  #shopify-section-{{ section.id }} .blogc__embed {
    position: relative;
    aspect-ratio: var(--blogc-ratio, 16 / 9);
  }
  /* Anything squarer than 16:9 would tower over a desktop screen at full
     width, so cap it by height instead — the width follows from the
     shape and the frame centres. Once the column is narrower than that
     (phones, and portrait video especially), width wins and the video
     runs edge to edge. Landscape is left alone. */
  #shopify-section-{{ section.id }} .blogc__embed--capped {
    width: 100%;
    max-width: calc(80vh * var(--blogc-ratio-num, 1));
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .blogc__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  #shopify-section-{{ section.id }} .blogc__caption {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 12px 0 0;
  }

  /* Product card */
  #shopify-section-{{ section.id }} .blogc__product {
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .blogc__product-card {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid #e2e2e2;
    padding: 12px;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .blogc__product-card img {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: cover;
    flex: none;
  }
  #shopify-section-{{ section.id }} .blogc__product-title {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 700;
    letter-spacing: 0;
    color: #121212;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blogc__product-meta {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blogc { padding: 0 12px 56px; }
    #shopify-section-{{ section.id }} .blogc__quotewrap {
      margin-top: 48px;
      margin-bottom: 48px;
    }
    #shopify-section-{{ section.id }} .blogc__heading { font-size: 22px; }
    #shopify-section-{{ section.id }} .blogc__quote { font-size: 24px; }
    #shopify-section-{{ section.id }} .blogc__media { margin-bottom: 32px; }
    /* On a phone the column is the constraint, not the screen height:
       every shape runs edge to edge, even where that makes it tall. */
    #shopify-section-{{ section.id }} .blogc__embed--capped { max-width: 100%; }
    #shopify-section-{{ section.id }} .blogc__media-row { gap: 8px; }
    /* 3-4 images wrap into two columns on mobile */
    #shopify-section-{{ section.id }} .blogc__media-row.has-many > div {
      flex: 1 1 calc(50% - 4px);
    }
    #shopify-section-{{ section.id }} .blogc__product { margin-bottom: 32px; }
  }
{% endstyle %}

<div class="blogc">
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'text' -%}
        <div class="blogc__text blogc__w-body" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="blogc__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {{ block.settings.body }}
        </div>

      {%- when 'quote' -%}
        {%- if block.settings.quote != blank -%}
          <div class="blogc__quotewrap" {{ block.shopify_attributes }}>
            <blockquote class="blogc__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</blockquote>
            {%- if block.settings.attribution != blank -%}
              <p class="blogc__quote-attr">{{ block.settings.attribution | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- when 'images' -%}
        {%- liquid
          assign img_count = 0
          if block.settings.image_1 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_2 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_3 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_4 != blank
            assign img_count = img_count | plus: 1
          endif
        -%}
        {%- if img_count > 0 -%}
          <figure class="blogc__media blogc__w-{{ block.settings.width }}" style="margin-inline: auto;" {{ block.shopify_attributes }}>
            <div class="blogc__media-row{% if img_count > 2 %} has-many{% endif %}">
              {%- for i in (1..4) -%}
                {%- liquid
                  case i
                    when 1
                      assign img = block.settings.image_1
                      assign img_caption = block.settings.caption_1
                    when 2
                      assign img = block.settings.image_2
                      assign img_caption = block.settings.caption_2
                    when 3
                      assign img = block.settings.image_3
                      assign img_caption = block.settings.caption_3
                    when 4
                      assign img = block.settings.image_4
                      assign img_caption = block.settings.caption_4
                  endcase
                -%}
                {%- if img != blank -%}
                  <div>
                    <img
                      src="{{ img | image_url: width: 1200 }}"
                      srcset="{{ img | image_url: width: 550 }} 550w, {{ img | image_url: width: 840 }} 840w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1680 }} 1680w, {{ img | image_url: width: 2048 }} 2048w"
                      sizes="(max-width: 749px) {% if img_count == 1 %}100vw{% else %}50vw{% endif %}, {% case block.settings.width %}{% when 'standard' %}{{ 760 | divided_by: img_count }}px{% when 'wide' %}{{ 1040 | divided_by: img_count }}px{% else %}{{ 100 | divided_by: img_count }}vw{% endcase %}"
                      width="{{ img.width }}"
                      height="{{ img.height }}"
                      alt="{{ img.alt | default: img_caption | escape }}"
                      loading="lazy"
                    >
                    {%- if img_caption != blank -%}
                      <p class="blogc__caption">{{ img_caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </figure>
        {%- endif -%}

      {%- when 'product' -%}
        {%- liquid
          assign card_product = block.settings.product
        -%}
        {%- if card_product != blank -%}
          <div class="blogc__product blogc__w-body" {{ block.shopify_attributes }}>
            <a href="{{ card_product.url }}" class="blogc__product-card">
              {%- if card_product.featured_media != blank -%}
                <img
                  src="{{ card_product.featured_media | image_url: width: 128 }}"
                  srcset="{{ card_product.featured_media | image_url: width: 128 }} 1x, {{ card_product.featured_media | image_url: width: 256 }} 2x"
                  width="64"
                  height="64"
                  alt="{{ card_product.title | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
              <span>
                <span class="blogc__product-title">{{ card_product.title | escape }}</span>
                <span class="blogc__product-meta">
                  {%- if block.settings.subtitle != blank -%}
                    {{ block.settings.subtitle | escape }}
                  {%- elsif card_product.available -%}
                    {{ card_product.price | money }}
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </span>
              </span>
            </a>
          </div>
        {%- endif -%}

      {%- when 'video' -%}
        {%- liquid
          # Language overrides: each slot lists the language codes it
          # serves; when the storefront language matches one, that slot's
          # video replaces the default. A matched slot with nothing in it
          # is ignored. Width, shape, autoplay and caption stay shared —
          # the caption is a text setting, translatable the usual way.
          assign v_video = block.settings.video
          assign v_url = block.settings.video_url
          assign v_lang = localization.language.iso_code | downcase
          assign v_slots = 'a,b,c,d,e,f,g,h' | split: ','
          for s in v_slots
            assign lang_key = 'lang_' | append: s
            assign v_codes = block.settings[lang_key]
            if v_codes == blank
              continue
            endif
            assign v_hit = false
            assign v_list = v_codes | downcase | split: ','
            for l in v_list
              assign l_t = l | strip
              if l_t == v_lang
                assign v_hit = true
                break
              endif
            endfor
            if v_hit
              assign vid_key = 'video_' | append: s
              assign url_key = 'video_url_' | append: s
              if block.settings[vid_key] != blank or block.settings[url_key] != blank
                assign v_video = block.settings[vid_key]
                assign v_url = block.settings[url_key]
              endif
              break
            endif
          endfor
        -%}
        <figure class="blogc__media blogc__w-{{ block.settings.width }}" style="margin-inline: auto;" {{ block.shopify_attributes }}>
          {%- if v_video != blank -%}
            {%- if block.settings.autoplay -%}
              {{ v_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {%- else -%}
              {{ v_video | video_tag: controls: true }}
            {%- endif -%}
          {%- elsif v_url != blank -%}
            {%- liquid
              case block.settings.shape
                when 'square'
                  assign v_ratio = '1 / 1'
                  assign v_num = '1'
                when 'portrait'
                  assign v_ratio = '4 / 5'
                  assign v_num = '0.8'
                when 'tall'
                  assign v_ratio = '9 / 16'
                  assign v_num = '0.5625'
                else
                  assign v_ratio = '16 / 9'
                  assign v_num = ''
              endcase
            -%}
            <div
              class="blogc__embed{% if v_num != blank %} blogc__embed--capped{% endif %}"
              style="--blogc-ratio: {{ v_ratio }};{% if v_num != blank %} --blogc-ratio-num: {{ v_num }};{% endif %}"
            >
              {%- if v_url.type == 'youtube' -%}
                <iframe src="https://www.youtube.com/embed/{{ v_url.id }}" title="{{ block.settings.caption | default: 'Video' | escape }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
              {%- elsif v_url.type == 'vimeo' -%}
                <iframe src="https://player.vimeo.com/video/{{ v_url.id }}" title="{{ block.settings.caption | default: 'Video' | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="blogc__caption">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Editorial content",
  "max_blocks": 50,
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Optional Display heading above the text." },
        { "type": "richtext", "id": "body", "label": "Text", "info": "Use bold for question-style subheadings." }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Quotation marks are added automatically." },
        { "type": "text", "id": "attribution", "label": "Attribution", "placeholder": "Massimo Vignelli" }
      ]
    },
    {
      "type": "images",
      "name": "Images",
      "settings": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "standard", "label": "Standard (760px)" },
            { "value": "wide", "label": "Wide (1040px)" },
            { "value": "ultrawide", "label": "Ultrawide (full width)" }
          ],
          "default": "standard"
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "caption_1", "label": "Caption 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "caption_2", "label": "Caption 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "text", "id": "caption_3", "label": "Caption 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "text", "id": "caption_4", "label": "Caption 4" }
      ]
    },
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Optional. Replaces the automatic price / sold-out line." }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "standard", "label": "Standard (760px)" },
            { "value": "wide", "label": "Wide (1040px)" },
            { "value": "ultrawide", "label": "Ultrawide (full width)" }
          ],
          "default": "standard"
        },
        { "type": "select", "id": "shape", "label": "Video shape", "info": "Match the video's own proportions. A portrait video left on Landscape is letterboxed by the player and looks tiny. Non-landscape shapes are sized to fit the screen height and go full width on phones.", "options": [ { "value": "landscape", "label": "Landscape (16:9)" }, { "value": "square", "label": "Square (1:1)" }, { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "tall", "label": "Tall (9:16)" } ], "default": "landscape" },
        { "type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted. Takes priority over the URL below." },
        { "type": "video_url", "id": "video_url", "label": "YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
        { "type": "checkbox", "id": "autoplay", "label": "Autoplay loop (muted)", "default": false, "info": "Shopify-hosted videos only." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "header", "content": "Language overrides", "info": "Optional. Show a different video to particular languages. Type the storefront language codes a slot serves, comma-separated (de, or zh-tw, ko). Leave the rest empty. A slot with codes but no video falls back to the default. Width, shape and autoplay are shared; the caption translates the usual way." },
        { "type": "text", "id": "lang_a", "label": "1. Languages" },
        { "type": "video", "id": "video_a", "label": "1. Video" },
        { "type": "video_url", "id": "video_url_a", "label": "1. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_b", "label": "2. Languages" },
        { "type": "video", "id": "video_b", "label": "2. Video" },
        { "type": "video_url", "id": "video_url_b", "label": "2. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_c", "label": "3. Languages" },
        { "type": "video", "id": "video_c", "label": "3. Video" },
        { "type": "video_url", "id": "video_url_c", "label": "3. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_d", "label": "4. Languages" },
        { "type": "video", "id": "video_d", "label": "4. Video" },
        { "type": "video_url", "id": "video_url_d", "label": "4. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_e", "label": "5. Languages" },
        { "type": "video", "id": "video_e", "label": "5. Video" },
        { "type": "video_url", "id": "video_url_e", "label": "5. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_f", "label": "6. Languages" },
        { "type": "video", "id": "video_f", "label": "6. Video" },
        { "type": "video_url", "id": "video_url_f", "label": "6. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_g", "label": "7. Languages" },
        { "type": "video", "id": "video_g", "label": "7. Video" },
        { "type": "video_url", "id": "video_url_g", "label": "7. URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "lang_h", "label": "8. Languages" },
        { "type": "video", "id": "video_h", "label": "8. Video" },
        { "type": "video_url", "id": "video_url_h", "label": "8. URL", "accept": ["youtube", "vimeo"] }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["article", "page", "product"]
  },
  "presets": [
    {
      "name": "Editorial content",
      "blocks": [
        { "type": "text" },
        { "type": "images" },
        { "type": "quote" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
