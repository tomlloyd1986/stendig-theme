{% comment %}
  Editorial content (file kept as blog-content for existing templates) —
  the shared editorial block stack, used on blog articles and below the
  product info on product pages (Avant Arte structure, the site's own
  type system):
    Text    — rich text in a centred 512px reading column, with an
              optional Display heading above ("Space and scale")
    Quote   — display-scale centred pull quote (curly quotes added)
    Images  — 1 to 4 images in a row, at Standard (840px), Wide (1200px)
              or Ultrawide (full width within the page gutters), with an
              optional caption
    Steps   — numbered 4:5 photo sequence (the sheet-removal guide),
              four across or two by two, spaced like any media block
    Product — small bordered product card (image, title, price/sold out)
              linking to the product
    Video   — Shopify-hosted upload or YouTube/Vimeo URL, same three
              widths, optional caption and autoplay loop. One slot per
              published language swaps in a different video for that
              language; an optional poster image replaces the player's
              own thumbnail and defers loading the player until clicked
  Widths, type and spacing are locked; only content is editable.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .blogc {
    /* The top padding is this block's own, wherever it lands. On an article
       it is the gap the Blog header used to hold below itself, moved here so
       the pair still reads the same; on a product page — where this block
       follows the recommendations with nothing between them — it is the gap
       that was missing entirely and the text ran into the component above.

       Coupled to `.blogh`'s bottom padding, which is now 0. The two are
       checked together in docs/spikes/editorial-spacing.mjs. */
    padding: 32px 20px 80px;
    max-width: var(--st-page-max, 1440px);
    margin-left: auto;
    margin-right: auto;
  }
  /* 512px ≈ 73 characters per line at 14px — the Avant Arte reading
     measure (their column is 512px at larger type). */
  #shopify-section-{{ section.id }} .blogc__w-body { max-width: 512px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-standard { max-width: 760px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-wide { max-width: 1040px; margin-left: auto; margin-right: auto; }
  #shopify-section-{{ section.id }} .blogc__w-ultrawide { max-width: none; }

  /* Text */
  #shopify-section-{{ section.id }} .blogc__heading {
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  #shopify-section-{{ section.id }} .blogc__text {
    margin-bottom: 28px;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
  }
  #shopify-section-{{ section.id }} .blogc__text p { margin: 0 0 21px; }
  #shopify-section-{{ section.id }} .blogc__text p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .blogc__text a {
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  #shopify-section-{{ section.id }} .blogc__text strong { font-weight: 700; }

  /* Quote */
  #shopify-section-{{ section.id }} .blogc__quotewrap {
    /* Clearly wider than the 512px reading column, per the handoff's
       original quote width — the quote should break the column */
    max-width: 680px;
    /* Equal top and bottom. The top margin collapses against the bottom
       margin of whatever block precedes it (text 28px, media/product
       48px), so it has to be the larger of the pair to survive — hence
       matching 72px rather than a smaller top value. */
    margin: 72px auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .blogc__quote {
    /* Reset Dawn's base blockquote (italic, grey, left border, padding) */
    margin: 0;
    padding: 0;
    border: none;
    font-style: normal;
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 30px;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-wrap: pretty;
  }
  #shopify-section-{{ section.id }} .blogc__quote-attr {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 12px 0 0;
  }

  /* Images / video */
  #shopify-section-{{ section.id }} .blogc__media {
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .blogc__media-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .blogc__media-row > div {
    flex: 1 1 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .blogc__media img,
  #shopify-section-{{ section.id }} .blogc__media video {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The frame takes the video's own shape. A portrait video in a 16:9
     frame is letterboxed by the player: the frame is full width but the
     picture shrinks to fit the height, so it ends up a narrow strip. */
  #shopify-section-{{ section.id }} .blogc__embed {
    position: relative;
    aspect-ratio: var(--blogc-ratio, 16 / 9);
  }
  /* Anything squarer than 16:9 would tower over a desktop screen at full
     width, so cap it by height instead — the width follows from the
     shape and the frame centres. Once the column is narrower than that
     (phones, and portrait video especially), width wins and the video
     runs edge to edge. Landscape is left alone. */
  #shopify-section-{{ section.id }} .blogc__embed--capped {
    width: 100%;
    max-width: calc(80vh * var(--blogc-ratio-num, 1));
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .blogc__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Our own poster, shown until the player is asked for */
  #shopify-section-{{ section.id }} .blogc__embed-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #f3f3f3;
    cursor: pointer;
    display: block;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .blogc__embed-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .blogc__embed-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(18, 18, 18, 0.75);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .blogc__embed-poster:hover .blogc__embed-play {
    background: #121212;
  }
  #shopify-section-{{ section.id }} .blogc__embed-play svg {
    width: 32px;
    height: 32px;
  }
  /* Step by step: numbered photo sequence. No divider, no heading of
     its own — it is a media block, so it takes .blogc__media's spacing
     exactly as an image row or a video does. */
  #shopify-section-{{ section.id }} .blogc__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .blogc__steps--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 10px;
  }
  #shopify-section-{{ section.id }} .blogc__step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .blogc__step-photo {
    width: 100%;
    /* The height attribute would otherwise win: base.css never resets
       image heights, so without this the attribute becomes a hard
       height and aspect-ratio is ignored. */
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    background: #f3f3f3;
  }
  #shopify-section-{{ section.id }} .blogc__step-num {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blogc__step-caption {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    /* net 4px under the number: cell gap 12px minus 8px */
    margin: -8px 0 0;
    text-wrap: pretty;
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .blogc__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 10px;
    }
  }
  #shopify-section-{{ section.id }} .blogc__caption {
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 19px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 12px 0 0;
  }

  /* Product card */
  #shopify-section-{{ section.id }} .blogc__product {
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .blogc__product-card {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid #e2e2e2;
    padding: 12px;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .blogc__product-card img {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: cover;
    flex: none;
  }
  #shopify-section-{{ section.id }} .blogc__product-title {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 700;
    letter-spacing: 0;
    color: #121212;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blogc__product-meta {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.6);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blogc { padding: 24px 12px 56px; }
    #shopify-section-{{ section.id }} .blogc__quotewrap {
      margin-top: 48px;
      margin-bottom: 48px;
    }
    #shopify-section-{{ section.id }} .blogc__heading { font-size: 22px; }
    #shopify-section-{{ section.id }} .blogc__quote { font-size: 24px; }
    #shopify-section-{{ section.id }} .blogc__media { margin-bottom: 32px; }
    /* On a phone the column is the constraint, not the screen height:
       every shape runs edge to edge, even where that makes it tall. */
    #shopify-section-{{ section.id }} .blogc__embed--capped { max-width: 100%; }
    #shopify-section-{{ section.id }} .blogc__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 10px;
    }
    #shopify-section-{{ section.id }} .blogc__step { gap: 10px; }
    #shopify-section-{{ section.id }} .blogc__step-caption { margin-top: -6px; }
    #shopify-section-{{ section.id }} .blogc__media-row { gap: 8px; }
    /* 3-4 images wrap into two columns on mobile */
    #shopify-section-{{ section.id }} .blogc__media-row.has-many > div {
      flex: 1 1 calc(50% - 4px);
    }
    #shopify-section-{{ section.id }} .blogc__product { margin-bottom: 32px; }
  }
{% endstyle %}

<div class="blogc">
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'text' -%}
        <div class="blogc__text blogc__w-body" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="blogc__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {{ block.settings.body }}
        </div>

      {%- when 'quote' -%}
        {%- if block.settings.quote != blank -%}
          <div class="blogc__quotewrap" {{ block.shopify_attributes }}>
            <blockquote class="blogc__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</blockquote>
            {%- if block.settings.attribution != blank -%}
              <p class="blogc__quote-attr">{{ block.settings.attribution | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- when 'images' -%}
        {%- liquid
          assign img_count = 0
          if block.settings.image_1 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_2 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_3 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_4 != blank
            assign img_count = img_count | plus: 1
          endif
        -%}
        {%- if img_count > 0 -%}
          <figure class="blogc__media blogc__w-{{ block.settings.width }}" style="margin-inline: auto;" {{ block.shopify_attributes }}>
            <div class="blogc__media-row{% if img_count > 2 %} has-many{% endif %}">
              {%- for i in (1..4) -%}
                {%- liquid
                  case i
                    when 1
                      assign img = block.settings.image_1
                      assign img_caption = block.settings.caption_1
                    when 2
                      assign img = block.settings.image_2
                      assign img_caption = block.settings.caption_2
                    when 3
                      assign img = block.settings.image_3
                      assign img_caption = block.settings.caption_3
                    when 4
                      assign img = block.settings.image_4
                      assign img_caption = block.settings.caption_4
                  endcase
                -%}
                {%- if img != blank -%}
                  <div>
                    <img
                      src="{{ img | image_url: width: 1200 }}"
                      srcset="{{ img | image_url: width: 550 }} 550w, {{ img | image_url: width: 840 }} 840w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1680 }} 1680w, {{ img | image_url: width: 2048 }} 2048w"
                      sizes="(max-width: 749px) {% if img_count == 1 %}100vw{% else %}50vw{% endif %}, {% case block.settings.width %}{% when 'standard' %}{{ 760 | divided_by: img_count }}px{% when 'wide' %}{{ 1040 | divided_by: img_count }}px{% else %}{{ 100 | divided_by: img_count }}vw{% endcase %}"
                      width="{{ img.width }}"
                      height="{{ img.height }}"
                      alt="{{ img.alt | default: img_caption | escape }}"
                      loading="lazy"
                    >
                    {%- if img_caption != blank -%}
                      <p class="blogc__caption">{{ img_caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </figure>
        {%- endif -%}

      {%- when 'product' -%}
        {%- liquid
          assign card_product = block.settings.product
        -%}
        {%- if card_product != blank -%}
          <div class="blogc__product blogc__w-body" {{ block.shopify_attributes }}>
            <a href="{{ card_product.url }}" class="blogc__product-card">
              {%- if card_product.featured_media != blank -%}
                <img
                  src="{{ card_product.featured_media | image_url: width: 128 }}"
                  srcset="{{ card_product.featured_media | image_url: width: 128 }} 1x, {{ card_product.featured_media | image_url: width: 256 }} 2x"
                  width="64"
                  height="64"
                  alt="{{ card_product.title | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
              <span>
                <span class="blogc__product-title">{{ card_product.title | escape }}</span>
                <span class="blogc__product-meta">
                  {%- if block.settings.subtitle != blank -%}
                    {{ block.settings.subtitle | escape }}
                  {%- elsif card_product.available -%}
                    {{ card_product.price | money }}
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </span>
              </span>
            </a>
          </div>
        {%- endif -%}

      {%- when 'steps' -%}
        {%- liquid
          # Only steps with a photo render, and the numbering follows what
          # actually appears — so leaving slot 2 empty gives 1, 2, 3, not
          # a gap. No eyebrow and no divider: the sequence is a media
          # block like any other.
          assign step_total = 0
          for i in (1..4)
            assign s_key = 'image_' | append: i
            if block.settings[s_key] != blank
              assign step_total = step_total | plus: 1
            endif
          endfor
        -%}
        {%- if step_total > 0 -%}
          <figure class="blogc__media blogc__w-{{ block.settings.width }}" style="margin-inline: auto;" {{ block.shopify_attributes }}>
            <div class="blogc__steps{% if block.settings.columns == '2' %} blogc__steps--2{% endif %}">
              {%- assign step_n = 0 -%}
              {%- for i in (1..4) -%}
                {%- liquid
                  assign img_key = 'image_' | append: i
                  assign cap_key = 'caption_' | append: i
                  assign step_image = block.settings[img_key]
                  assign step_caption = block.settings[cap_key]
                -%}
                {%- if step_image != blank -%}
                  {%- assign step_n = step_n | plus: 1 -%}
                  <div class="blogc__step">
                    <img
                      class="blogc__step-photo"
                      src="{{ step_image | image_url: width: 720 }}"
                      srcset="{{ step_image | image_url: width: 360 }} 360w, {{ step_image | image_url: width: 540 }} 540w, {{ step_image | image_url: width: 720 }} 720w, {{ step_image | image_url: width: 1080 }} 1080w"
                      sizes="{% if block.settings.columns == '2' %}(max-width: 749px) calc((100vw - 34px) / 2), {% case block.settings.width %}{% when 'standard' %}375px{% when 'wide' %}515px{% else %}calc((100vw - 50px) / 2){% endcase %}{% else %}(max-width: 989px) calc((100vw - 34px) / 2), {% case block.settings.width %}{% when 'standard' %}190px{% when 'wide' %}260px{% else %}calc((100vw - 70px) / 4){% endcase %}{% endif %}"
                      alt="{{ step_image.alt | default: step_caption | escape }}"
                      width="{{ step_image.width }}"
                      height="{{ step_image.height }}"
                      loading="lazy"
                    >
                    <p class="blogc__step-num">{{ step_n }}.</p>
                    {%- if step_caption != blank -%}
                      <p class="blogc__step-caption">{{ step_caption }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </figure>
        {%- endif -%}

      {%- when 'video' -%}
        {%- liquid
          # Language overrides: each slot lists the language codes it
          # serves; when the storefront language matches one, that slot's
          # video replaces the default. A matched slot with nothing in it
          # is ignored. Width, shape, autoplay and caption stay shared —
          # the caption is a text setting, translatable the usual way.
          assign v_video = block.settings.video
          assign v_url = block.settings.video_url
          assign v_lang = localization.language.iso_code | downcase
          assign v_slots = 'a,b,c,d,e,f,g,h' | split: ','
          for s in v_slots
            assign lang_key = 'lang_' | append: s
            assign v_codes = block.settings[lang_key]
            if v_codes == blank
              continue
            endif
            assign v_hit = false
            assign v_list = v_codes | downcase | split: ','
            for l in v_list
              assign l_t = l | strip
              if l_t == v_lang
                assign v_hit = true
                break
              endif
            endfor
            if v_hit
              assign vid_key = 'video_' | append: s
              assign url_key = 'video_url_' | append: s
              if block.settings[vid_key] != blank or block.settings[url_key] != blank
                assign v_video = block.settings[vid_key]
                assign v_url = block.settings[url_key]
              endif
              break
            endif
          endfor
        -%}
        <figure class="blogc__media blogc__w-{{ block.settings.width }}" style="margin-inline: auto;" {{ block.shopify_attributes }}>
          {%- if v_video != blank -%}
            {%- liquid
              # video_tag builds the poster from the video's preview image,
              # and without image_size it asks for a small one — which the
              # browser then stretches over the whole frame, soft, while
              # the video itself plays sharp. Size it to the widest the
              # frame can be at this width setting, doubled for retina.
              case block.settings.width
                when 'standard'
                  assign v_poster_size = '1600x'
                when 'wide'
                  assign v_poster_size = '2200x'
                else
                  assign v_poster_size = '2800x'
              endcase
            -%}
            {%- if block.settings.autoplay -%}
              {{ v_video | video_tag: image_size: v_poster_size, autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {%- else -%}
              {{ v_video | video_tag: image_size: v_poster_size, controls: true }}
            {%- endif -%}
          {%- elsif v_url != blank -%}
            {%- liquid
              case block.settings.shape
                when 'square'
                  assign v_ratio = '1 / 1'
                  assign v_num = '1'
                when 'portrait'
                  assign v_ratio = '4 / 5'
                  assign v_num = '0.8'
                when 'tall'
                  assign v_ratio = '9 / 16'
                  assign v_num = '0.5625'
                else
                  assign v_ratio = '16 / 9'
                  assign v_num = ''
              endcase
            -%}
            {%- liquid
              assign v_src = ''
              assign v_allow = 'autoplay; fullscreen; picture-in-picture'
              if v_url.type == 'youtube'
                assign v_src = 'https://www.youtube.com/embed/' | append: v_url.id
                assign v_allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
              elsif v_url.type == 'vimeo'
                assign v_src = 'https://player.vimeo.com/video/' | append: v_url.id
              endif
              assign v_title = block.settings.caption | default: 'Video'
            -%}
            <div
              class="blogc__embed{% if v_num != blank %} blogc__embed--capped{% endif %}"
              style="--blogc-ratio: {{ v_ratio }};{% if v_num != blank %} --blogc-ratio-num: {{ v_num }};{% endif %}"
            >
              {%- if v_src != blank -%}
                {%- if block.settings.poster != blank -%}
                  {%- comment -%}
                    The player's own poster is served at whatever size it
                    measures the frame to be as it starts up, which on a
                    large frame is an upscaled small image — soft, even
                    though the video itself is sharp. A still we control is
                    sharp at any size, and holds the third-party player
                    back until someone actually wants it.
                  {%- endcomment -%}
                  <button
                    type="button"
                    class="blogc__embed-poster"
                    data-embed-src="{{ v_src }}"
                    data-embed-allow="{{ v_allow }}"
                    data-embed-title="{{ v_title | escape }}"
                    aria-label="{{ 'Play video' }}{% if block.settings.caption != blank %}: {{ block.settings.caption | escape }}{% endif %}"
                  >
                    <img
                      src="{{ block.settings.poster | image_url: width: 1600 }}"
                      srcset="{{ block.settings.poster | image_url: width: 800 }} 800w, {{ block.settings.poster | image_url: width: 1200 }} 1200w, {{ block.settings.poster | image_url: width: 1600 }} 1600w, {{ block.settings.poster | image_url: width: 2400 }} 2400w"
                      sizes="(max-width: 749px) 100vw, {% case block.settings.width %}{% when 'standard' %}760px{% when 'wide' %}1040px{% else %}100vw{% endcase %}"
                      alt="{{ block.settings.poster.alt | default: v_title | escape }}"
                      width="{{ block.settings.poster.width }}"
                      height="{{ block.settings.poster.height }}"
                      loading="lazy"
                    >
                    <span class="blogc__embed-play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M9 7.5v9l7-4.5-7-4.5z" fill="currentColor"/></svg>
                    </span>
                  </button>
                {%- else -%}
                  <iframe src="{{ v_src }}" title="{{ v_title | escape }}" allow="{{ v_allow }}" allowfullscreen loading="lazy"></iframe>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="blogc__caption">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>

    {%- endcase -%}
  {%- endfor -%}
</div>

<script>
  /* Swap a poster for the real player on click. Delegated from the
     document and registered once, so it survives the editor re-rendering
     a section and covers every Editorial content block on the page. */
  (function () {
    if (window.__blogcPosterBound) return;
    window.__blogcPosterBound = true;
    document.addEventListener('click', function (e) {
      var poster = e.target.closest && e.target.closest('.blogc__embed-poster');
      if (!poster) return;
      var src = poster.dataset.embedSrc;
      if (!src) return;
      var frame = document.createElement('iframe');
      frame.src = src + (src.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1';
      frame.title = poster.dataset.embedTitle || 'Video';
      frame.setAttribute('allow', poster.dataset.embedAllow || 'autoplay; fullscreen; picture-in-picture');
      frame.setAttribute('allowfullscreen', '');
      poster.replaceWith(frame);
    });
  })();
</script>

