{% comment %}
  Hero banner — native rebuild of the PageFly home-page hero.
  Full-bleed image below the header with a bottom-centred button; the whole
  hero is one link. Three image crops (desktop / tablet / mobile) with the
  desktop image as fallback. Height fills the viewport below the measured
  header (--st-header-bottom, kept in sync by the header section).
  Editable: images, button label, link. Spacing/typography locked.

  Shape-aware crops: the page-width cap (1440px) pins the hero's width
  while its height keeps tracking the viewport, so on large screens the
  box collapses toward tablet and then phone proportions. Above the cap
  the box's aspect ratio depends only on viewport HEIGHT, so min-height
  sources serve the tablet/mobile crop once the box's ratio crosses the
  midpoint between two crops' ratios — each box shape gets the crop
  composed nearest to it. Thresholds are derived from the uploaded
  images' actual ratios (box height ~= viewport - 84px: header 64 +
  bottom gutter 20). Below the cap the thresholds are conservative: the
  box there is even narrower, so a switch is never wrong, only late.
{% endcomment %}

{%- liquid
  assign img_d = section.settings.image_desktop
  assign img_t = section.settings.image_tablet | default: img_d
  assign img_m = section.settings.image_mobile | default: img_d

  # Viewport-height thresholds for the shape-based sources (0 = never).
  # Guarded so a missing upload, or one no narrower than the crop above
  # it, simply never triggers.
  assign shape_t_h = 0
  assign shape_m_h = 0
  if img_d != blank
    assign base_ratio = img_d.aspect_ratio
    if section.settings.image_tablet != blank and img_t.aspect_ratio < base_ratio
      assign mid = base_ratio | plus: img_t.aspect_ratio | divided_by: 2.0
      assign shape_t_h = 1400.0 | divided_by: mid | plus: 84 | round
      assign base_ratio = img_t.aspect_ratio
    endif
    if section.settings.image_mobile != blank and img_m.aspect_ratio < base_ratio
      assign mid = base_ratio | plus: img_m.aspect_ratio | divided_by: 2.0
      assign shape_m_h = 1400.0 | divided_by: mid | plus: 84 | round
    endif
  endif
  # Locale-aware fallback: routes.root_url is '/' on the default market and
  # e.g. '/en-au' on subfolder markets, so the range link stays in-market.
  assign hero_link = section.settings.link
  if hero_link == blank
    assign locale_root = routes.root_url
    if locale_root == '/'
      assign locale_root = ''
    endif
    assign hero_link = locale_root | append: '/collections/range'
  endif
  assign button_label = section.settings.button_label
-%}

{% style %}
  #shopify-section-{{ section.id }} .hero {
    padding: 0 20px;
    max-width: var(--st-page-max, 1440px);
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .hero__link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    height: calc(100vh - var(--st-header-bottom, 64px) - 20px);
    height: calc(100svh - var(--st-header-bottom, 64px) - 20px);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .hero__media,
  #shopify-section-{{ section.id }} .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .hero__media img {
    object-fit: cover;
    object-position: center center;
  }
  #shopify-section-{{ section.id }} .hero__placeholder {
    position: absolute;
    inset: 0;
    background: #f3f3f3;
  }
  #shopify-section-{{ section.id }} .hero__button {
    position: relative;
    z-index: 1;
    background-color: #161616;
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 16px;
    font-weight: 400;
    letter-spacing: 0;
    padding: 16px 26px;
    margin-bottom: 30px;
    text-align: center;
  }
  @media screen and (max-width: 989px) {
    /* Smaller screens anchor the image to its bottom edge, like the live site */
    #shopify-section-{{ section.id }} .hero__media img {
      object-position: center bottom;
    }
  }
  {%- if shape_t_h > 0 %}
  /* Large screens serving the tablet/mobile crop anchor it the same way
     those crops are anchored on their native screens */
  @media screen and (min-width: 990px) and (min-height: {{ shape_t_h }}px) {
    #shopify-section-{{ section.id }} .hero__media img {
      object-position: center bottom;
    }
  }
  {%- endif %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero { padding: 0 12px; }
  }
{% endstyle %}

<div class="hero">
  <a
    href="{{ hero_link }}"
    class="hero__link"
    {% if button_label != blank %}aria-label="{{ button_label | escape }}"{% endif %}
  >
    {%- if img_d != blank -%}
      <picture class="hero__media">
        {%- if img_m != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w, {{ img_m | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {%- endif -%}
        {%- if img_t != blank -%}
          <source
            media="(max-width: 989px)"
            srcset="{{ img_t | image_url: width: 1100 }} 1100w, {{ img_t | image_url: width: 1600 }} 1600w, {{ img_t | image_url: width: 2048 }} 2048w"
            sizes="100vw"
          >
        {%- endif -%}
        {%- comment -%}
          Shape-based sources for large screens (see header comment).
          Order matters: the small-screen sources above win first, then
          the taller mobile-shape threshold must precede the tablet one.
        {%- endcomment -%}
        {%- if shape_m_h > 0 -%}
          <source
            media="(min-width: 990px) and (min-height: {{ shape_m_h }}px)"
            srcset="{{ img_m | image_url: width: 1100 }} 1100w, {{ img_m | image_url: width: 1600 }} 1600w, {{ img_m | image_url: width: 2200 }} 2200w, {{ img_m | image_url: width: 2800 }} 2800w"
            sizes="(min-width: 1440px) 1400px, calc(100vw - 40px)"
          >
        {%- endif -%}
        {%- if shape_t_h > 0 -%}
          <source
            media="(min-width: 990px) and (min-height: {{ shape_t_h }}px)"
            srcset="{{ img_t | image_url: width: 1100 }} 1100w, {{ img_t | image_url: width: 1600 }} 1600w, {{ img_t | image_url: width: 2200 }} 2200w, {{ img_t | image_url: width: 2800 }} 2800w"
            sizes="(min-width: 1440px) 1400px, calc(100vw - 40px)"
          >
        {%- endif -%}
        <img
          src="{{ img_d | image_url: width: 2048 }}"
          srcset="{{ img_d | image_url: width: 1400 }} 1400w, {{ img_d | image_url: width: 2048 }} 2048w, {{ img_d | image_url: width: 2600 }} 2600w"
          sizes="100vw"
          width="{{ img_d.width }}"
          height="{{ img_d.height }}"
          alt="{{ img_d.alt | escape }}"
          fetchpriority="high"
        >
      </picture>
    {%- else -%}
      <span class="hero__placeholder" role="presentation"></span>
    {%- endif -%}

    {%- if button_label != blank -%}
      <span class="hero__button">{{ button_label | escape }}</span>
    {%- endif -%}
  </a>
</div>

{% schema %}
{
  "name": "Home: Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Image — desktop" },
    { "type": "image_picker", "id": "image_tablet", "label": "Image — tablet", "info": "Optional. Falls back to the desktop image. Also shown on very large screens when the hero's shape approaches tablet proportions — upload at least 2000px wide." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image — mobile", "info": "Optional. Falls back to the desktop image. Also shown on very tall screens when the hero's shape approaches phone proportions — upload at least 2000px wide." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "DISCOVER 2026" },
    { "type": "url", "id": "link", "label": "Link", "info": "Where the button — and the whole hero — points. Defaults to the range collection." }
  ],
  "presets": [
    { "name": "Home: Hero banner" }
  ]
}
{% endschema %}
