{% style %}
  {% if section.settings.transparent-header %}
    .template-index #shopify-section-{{ section.id }}:not(.scrolled) .st-header__link,
    .template-index #shopify-section-{{ section.id }}:not(.scrolled) .st-header__logo-text {
      color: {{ section.settings.transparent-color }}
    }
    /* While the mobile menu is open the bar gets its background back, so the
       nav text must drop the transparent-header colour too. */
    body.template-index.st-menu-open #shopify-section-{{ section.id }}:not(.scrolled) .st-header__link,
    body.template-index.st-menu-open #shopify-section-{{ section.id }}:not(.scrolled) .st-header__logo-text {
      color: rgb(var(--color-foreground));
    }
  {% endif %}
{% endstyle %}
