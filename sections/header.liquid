<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  /* Stendig header — Asket-style text navigation
     Layout: [logo · Products]  ...  [Search · Cart (x)]
     All nav items are 14px text (1.4rem), matching product/section titles. */

  #shopify-section-{{ section.id }} .header {
    display: flex;
    /* Bottom-align so the nav/cart text sits on the logo's bottom edge */
    align-items: flex-end;
    gap: 3rem;
    /* !important beats base.css's forced 0 padding at >=990px */
    padding-top: 1.6rem !important;
    padding-bottom: 1.6rem !important;
  }

  /* ---- Ported from the header section's theme-editor Custom CSS, so that
     box can be safely emptied. Scoped to the section and placed after the
     base rule above so the outcome is identical to the editor version. ---- */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .header {
      padding-top: 8px !important;
      padding-bottom: 8px !important;
    }
    #shopify-section-{{ section.id }} .header__heading-logo img {
      max-height: 36px !important;
    }
    #shopify-section-{{ section.id }} .header {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
  }
  /* The bar's content caps at the site-wide max width (the white background
     and hairline on the wrapper still span the full viewport). */
  #shopify-section-{{ section.id }} .header {
    max-width: var(--st-page-max, 1440px) !important;
    margin-left: auto;
    margin-right: auto;
  }
  /* On mobile the side gutter is 12px (the Custom CSS previously forced 20px
     at every width, quietly overriding the intended mobile gutter). */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .header {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
  }
  /* ---- end ported Custom CSS ---- */

  /* Mobile only (<=749px): extend the white bar below the content. The
     .header.st-header selector out-specifies the base `.header` rule above
     (which is !important at all widths); the media query keeps desktop
     exactly as-is. */
  @media screen and (max-width: 749px) {
    /* [data-sticky] is on the header wrapper; including it lifts specificity
       above the theme Custom CSS rule
       `.template-index #shopify-section-header [data-sticky=true] > header`
       which otherwise caps the home-page mobile bar at 10px !important. */
    #shopify-section-{{ section.id }} [data-sticky] > header.header.st-header {
      padding-bottom: 1.4rem !important;
    }
  }

  /* Positioning anchor for the Resources dropdown and the mobile menu panel
     (both hang from the header's bottom hairline) + sticky/transparent
     behaviour. */
  .header-wrapper {
    position: relative;
    z-index: 30;
    {% if section.settings.transparent-header %}background-color: transparent;{% endif %}
    transition: background-color 0.3s ease-in-out;
  }
  body.st-menu-open .header-wrapper { background-color: rgb(var(--color-background)); }
  #shopify-section-{{ section.id }}.scrolled sticky-header { background-color: #ffffff; }
  {% if section.settings.enable_sticky_header %}
    .template-index #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      transform: unset !important;
      width: 100%;
    }
  {% endif %}
  {% if section.settings.transparent-header %}
    .template-index #shopify-section-{{ section.id }} sticky-header {
      position: absolute;
      width: 100%;
    }
  {% endif %}

  /* Logo, nav and utility are the three top-level items of the header.
     On desktop the nav's auto right-margin pushes utility to the right:
       [logo] [nav]  ........  [search cart]
     On mobile the nav is reordered to the far right, after the cart. */
  .st-header__nav {
    display: flex;
    align-items: flex-end;
    gap: 2.4rem;
    margin-right: auto;
  }
  .st-header__utility {
    display: flex;
    align-items: flex-end;
    gap: 2.4rem;
  }
  /* Vertical nudge for the nav/cart text — set from the theme editor.
     Negative moves them up to sit on the logo's bottom edge. */
  .st-header__nav,
  .st-header__utility {
    transform: translateY({{ section.settings.nav_offset_desktop | default: 0 }}px);
  }

  /* Logo wrappers are flex/flex-end and line-height 0 so the header aligns
     to the true bottom of the wordmark, not the font's line-box metrics. */
  .st-header__logo-h {
    display: flex;
    align-items: flex-end;
    margin: 0;
    line-height: 0;
  }
  .st-header__logo {
    display: flex;
    align-items: flex-end;
    line-height: 0;
    text-decoration: none;
    color: inherit;
  }
  .st-header__logo-text {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    color: inherit;
  }
  .st-header__logo .header__heading-logo { display: block; }

  .st-header__link {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    display: inline-block;
    padding: 0;
    white-space: nowrap;
  }
  .st-header__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Collection is a plain link — the only nav item with a colour (opacity)
     fade on hover instead of an underline, distinguishing "this is a page"
     from the dropdown triggers around it. */
  .st-header__collection { transition: opacity 0.15s ease; }
  .st-header__collection:hover {
    text-decoration: none;
    opacity: 0.55;
  }

  /* Resources trigger stays underlined while its dropdown is open */
  .st-resources__toggle[aria-expanded="true"] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Strip the native <summary> disclosure marker */
  .header summary { list-style: none; cursor: pointer; }
  .header summary::-webkit-details-marker { display: none; }

  /* Cart label: keep "Cart (0)" as tight inline text */
  .st-header__cart { display: inline-block; }
  .st-header__cart-label { margin-right: 0.4rem; }

  /* ===== Resources dropdown (desktop) =====
     Hung from the header's bottom hairline: top = header bottom, flush under
     the border (border-top: none — the hairline is its top edge), right-
     aligned to the header's 20px gutter. No radius, shadow or animation. */
  .st-nav-menus { display: contents; }
  .st-resources {
    position: absolute;
    top: 100%;
    /* Track the capped header content's right gutter, not the viewport edge */
    right: max(20px, calc((100% - var(--st-page-max, 1440px)) / 2 + 20px));
    width: 300px;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid #e2e2e2;
    border-top: none;
    padding: 20px;
    display: none;
  }
  .st-resources.is-open { display: block; }
  .st-resources__link {
    display: block;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-decoration: none;
    padding: 6px 0;
  }
  .st-resources__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  .st-resources__rule {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 14px 0;
  }

  /* ===== Mobile menu panel =====
     Full width under the header. The collection link is the only full-
     strength item; Resources and Search read as secondary (muted Display). */
  .st-mmenu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-bottom: 1px solid #e2e2e2;
    padding: 32px 12px 40px;
    display: none;
  }
  .st-mmenu.is-open { display: block; }
  .st-mmenu__collection {
    display: block;
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 32px;
    line-height: 38px;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    text-decoration: none;
    padding: 8px 0;
  }
  .st-mmenu__rule {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 28px 0;
  }
  .st-mmenu__row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    background: none;
    border: none;
    margin: 0;
    padding: 8px 0;
    cursor: pointer;
    text-align: left;
    font-family: "Neue Haas Grotesk Display", var(--font-heading-family), sans-serif;
    font-size: 24px;
    line-height: 30px;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(18, 18, 18, 0.55);
  }
  .st-mmenu__glyph {
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1;
  }
  .st-mmenu__sub { display: none; padding: 8px 0 12px; }
  .st-mmenu__sub.is-open { display: block; }
  .st-mmenu__sublink {
    display: block;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 21px;
    font-weight: 400;
    letter-spacing: 0;
    color: #121212;
    text-decoration: none;
    padding: 8px 0;
  }
  .st-mmenu__journal {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Menu toggle: "Menu" swaps to a ✕ while open (mobile only element) */
  .st-mmenu__toggle-close { display: none; line-height: 0; }
  .st-mmenu__toggle[aria-expanded="true"] .st-mmenu__toggle-open { display: none; }
  .st-mmenu__toggle[aria-expanded="true"] .st-mmenu__toggle-close { display: inline-block; }

  /* Desktop: no Menu toggle, no mobile panel */
  @media screen and (min-width: 750px) {
    .st-mmenu__toggle { display: none; }
    .st-mmenu { display: none !important; }
  }

  /* Mobile: 12px gutters; Collection, Resources and Search all live in the
     menu panel, so the bar reduces to [logo] .... [Cart (n)] [Menu] */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .header {
      gap: 1.6rem;
      padding-top: 2rem;
      padding-bottom: 2.8rem;
    }
    .st-header__utility {
      gap: 2.4rem;
      transform: translateY({{ section.settings.nav_offset_mobile | default: 0 }}px);
    }
    #shopify-section-{{ section.id }} .page-width {
      padding-left: 12px;
      padding-right: 12px;
    }
    .st-header__nav { display: none; }
    .st-resources__toggle { display: none; }
    .st-resources { display: none !important; }
    /* Search's summary trigger is hidden but the <details> stays reachable —
       the menu panel's Search row opens it as a modal. display: contents +
       hiding the closed details keeps it out of the flex gap arithmetic. */
    .st-header__search { display: contents; }
    .st-header__search summary { display: none; }
    .st-header__search details:not([open]) { display: none; }
    #shopify-section-{{ section.id }} .header > *:first-child { margin-right: auto; }
    /* ✕ takes the right edge while the menu is open */
    body.st-menu-open .st-header__cart { display: none; }
  }
</style>

<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>

<{% if section.settings.enable_sticky_header %}sticky-header{% else %}div{% endif %} class="header-wrapper transparent-header color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}" data-sticky="{{ section.settings.enable_sticky_header }}">
  <header class="header page-width st-header">
    {%- comment -%} Logo {%- endcomment -%}
      {%- if request.page_type == 'index' -%}<h1 class="header__heading st-header__logo-h">{%- endif -%}
        <a href="{{ routes.root_url }}" class="header__heading-link st-header__logo link link--text focus-inset">
          {%- if section.settings.logo != blank -%}
            {%- assign image_size = section.settings.logo_width | append: 'x' -%}
            {%- if section.settings.altlogo.src != blank and section.settings.transparent-header -%}
              <img srcset="{{ section.settings.altlogo | img_url: image_size }} 1x, {{ section.settings.altlogo | img_url: image_size, scale: 2 }} 2x"
                src="{{ section.settings.altlogo | img_url: image_size }}"
                loading="lazy"
                class="header__heading-logo altlogo"
                width="{{ section.settings.altlogo.width }}"
                height="{{ section.settings.altlogo.height }}"
                alt="{{ section.settings.altlogo.alt | default: shop.name | escape }}"
              >
            {%- endif -%}
            <img srcset="{{ section.settings.logo | img_url: image_size }} 1x, {{ section.settings.logo | img_url: image_size, scale: 2 }} 2x"
              src="{{ section.settings.logo | img_url: image_size }}"
              loading="lazy"
              class="header__heading-logo"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
          {%- else -%}
            <span class="st-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      {%- if request.page_type == 'index' -%}</h1>{%- endif -%}

      {%- liquid
        assign collection_url = section.settings.collection_url | default: routes.all_products_collection_url
        assign has_resources = false
        if section.settings.resources_menu != blank and section.settings.resources_menu.links.size > 0
          assign has_resources = true
        endif
        assign show_resources = false
        if has_resources or section.settings.journal_url != blank
          assign show_resources = true
        endif
      -%}

      {%- comment -%} Collection — a plain link, deliberately not a dropdown {%- endcomment -%}
      <nav class="st-header__nav">
        <a href="{{ collection_url }}" class="st-header__link st-header__collection focus-inset">{{ section.settings.collection_label | default: 'Collection' | escape }}</a>
      </nav>

    <div class="st-header__utility">
      {%- comment -%} Resources dropdown trigger (desktop only) {%- endcomment -%}
      {%- if show_resources -%}
        <button
          type="button"
          class="st-header__link st-resources__toggle focus-inset"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="StResources-{{ section.id }}"
        >{{ section.settings.resources_label | default: 'Resources' | escape }}</button>
      {%- endif -%}
      {%- comment -%} Search — text trigger, hidden on mobile {%- endcomment -%}
      <details-modal class="header__search st-header__search">
        <details>
          <summary class="st-header__link focus-inset" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
            {{ 'general.search.search' | t }}
          </summary>
          <div class="search-modal modal__content" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
            <div class="modal-overlay"></div>
            <div class="search-modal__content" tabindex="-1">
              {%- if settings.predictive_search_enabled -%}
                <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
              {%- endif -%}
                <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                  <div class="field">
                    <input class="search__input field__input"
                      id="Search-In-Modal"
                      type="search"
                      name="q"
                      value=""
                      placeholder="{{ 'general.search.search' | t }}"
                      {%- if settings.predictive_search_enabled -%}
                        role="combobox"
                        aria-expanded="false"
                        aria-owns="predictive-search-results-list"
                        aria-controls="predictive-search-results-list"
                        aria-haspopup="listbox"
                        aria-autocomplete="list"
                        autocorrect="off"
                        autocomplete="off"
                        autocapitalize="off"
                        spellcheck="false"
                      {%- endif -%}
                    >
                    <label class="field__label" for="Search-In-Modal">{{ 'general.search.search' | t }}</label>
                    <input type="hidden" name="options[prefix]" value="last">
                    <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                      <svg class="icon icon-search" aria-hidden="true" focusable="false" role="presentation">
                        <use href="#icon-search">
                      </svg>
                    </button>
                  </div>

                  {%- if settings.predictive_search_enabled -%}
                    <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                      <div class="predictive-search__loading-state">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                        </svg>
                      </div>
                    </div>

                    <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                  {%- endif -%}
                </form>
              {%- if settings.predictive_search_enabled -%}
                </predictive-search>
              {%- endif -%}
              <button type="button" class="search-modal__close-button modal__close-button link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
                <svg class="icon icon-close" aria-hidden="true" focusable="false" role="presentation">
                  <use href="#icon-close">
                </svg>
              </button>
            </div>
          </div>
        </details>
      </details-modal>

      {%- comment -%} Cart with live "(x)" count {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="st-header__link st-header__cart focus-inset" id="cart-icon-bubble">
        {%- render 'cart-count' -%}
      </a>

      {%- comment -%} Mobile menu toggle — "Menu" text, ✕ while open {%- endcomment -%}
      <button
        type="button"
        class="st-header__link st-mmenu__toggle focus-inset"
        aria-expanded="false"
        aria-controls="StMobileMenu-{{ section.id }}"
        aria-label="{{ section.settings.menu_label | default: 'Menu' | escape }}"
        data-label="{{ section.settings.menu_label | default: 'Menu' | escape }}"
      ><span class="st-mmenu__toggle-open">{{ section.settings.menu_label | default: 'Menu' | escape }}</span><span class="st-mmenu__toggle-close" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1"/></svg></span></button>
    </div>
  </header>

  {%- comment -%}
    Dropdown / menu panels live inside .header-wrapper (its positioned,
    untransformed box is what they hang from) but outside the nav/utility
    flex items, whose translateY would otherwise become their containing
    block. <st-nav-menus> is display: contents, so it adds no box.
  {%- endcomment -%}
  <st-nav-menus class="st-nav-menus" data-header="shopify-section-{{ section.id }}">
    {%- if show_resources -%}
      <div class="st-resources" id="StResources-{{ section.id }}">
        {%- if has_resources -%}
          {%- for link in section.settings.resources_menu.links -%}
            <a href="{{ link.url }}" class="st-resources__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.journal_url != blank -%}
          {%- if has_resources -%}<hr class="st-resources__rule">{%- endif -%}
          <a href="{{ section.settings.journal_url }}" class="st-resources__link">{{ section.settings.journal_label | default: 'Browse the journal' | escape }} &rarr;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="st-mmenu" id="StMobileMenu-{{ section.id }}">
      <a href="{{ collection_url }}" class="st-mmenu__collection">{{ section.settings.mobile_collection_label | default: 'Browse the collection' | escape }}</a>
      <hr class="st-mmenu__rule">
      {%- if show_resources -%}
        <button
          type="button"
          class="st-mmenu__row st-mmenu__acc"
          aria-expanded="false"
          aria-controls="StMobileResources-{{ section.id }}"
        ><span>{{ section.settings.resources_label | default: 'Resources' | escape }}</span><span class="st-mmenu__glyph" aria-hidden="true" data-glyph>+</span></button>
        <div class="st-mmenu__sub" id="StMobileResources-{{ section.id }}">
          {%- if has_resources -%}
            {%- for link in section.settings.resources_menu.links -%}
              <a href="{{ link.url }}" class="st-mmenu__sublink"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.journal_url != blank -%}
            <a href="{{ section.settings.journal_url }}" class="st-mmenu__sublink st-mmenu__journal">{{ section.settings.journal_label | default: 'Browse the journal' | escape }} &rarr;</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <button type="button" class="st-mmenu__row st-mmenu__searchrow">{{ 'general.search.search' | t }}</button>
    </div>
  </st-nav-menus>
</{% if section.settings.enable_sticky_header %}sticky-header{% else %}div{% endif %}>

{%- render 'cart-notification', color_scheme: section.settings.color_scheme -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.getElementById('shopify-section-header');
      this.headerBounds = {};
      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => this.preventReveal = true;

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('details-disclosure');
      this.disclosures.forEach(disclosure => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (this.searchModal) this.searchModal.close(false);
    }

  }

  if (!customElements.get('sticky-header')) customElements.define('sticky-header', StickyHeader);

  class StNavMenus extends HTMLElement {
    connectedCallback() {
      const root = document.getElementById(this.dataset.header) || document;
      this.headerWrapper = root.querySelector('.header-wrapper');
      this.resPanel = this.querySelector('.st-resources');
      this.resToggle = root.querySelector('.st-resources__toggle');
      this.menuPanel = this.querySelector('.st-mmenu');
      this.menuToggle = root.querySelector('.st-mmenu__toggle');
      this.acc = this.querySelector('.st-mmenu__acc');
      this.sub = this.querySelector('.st-mmenu__sub');
      this.searchRow = this.querySelector('.st-mmenu__searchrow');
      this.searchSummary = root.querySelector('.st-header__search summary');
      this.desktop = window.matchMedia('(min-width: 750px)');

      if (this.resToggle && this.resPanel) {
        this.resToggle.addEventListener('click', () => this.setResources(!this.resPanel.classList.contains('is-open')));
        // Hover-open is desktop behaviour; touch/click still toggles
        this.resToggle.addEventListener('mouseenter', () => { if (this.desktop.matches) this.setResources(true); });
        this.onWrapperLeave = () => this.setResources(false);
        if (this.headerWrapper) this.headerWrapper.addEventListener('mouseleave', this.onWrapperLeave);
      }
      if (this.menuToggle && this.menuPanel) {
        this.menuToggle.addEventListener('click', () => this.setMenu(!this.menuPanel.classList.contains('is-open')));
      }
      if (this.acc && this.sub) {
        // Instant expand/collapse — no animation, like the rest of the theme
        this.acc.addEventListener('click', () => {
          const open = !this.sub.classList.contains('is-open');
          this.sub.classList.toggle('is-open', open);
          this.acc.setAttribute('aria-expanded', open ? 'true' : 'false');
          const glyph = this.acc.querySelector('[data-glyph]');
          if (glyph) glyph.textContent = open ? '−' : '+';
        });
      }
      if (this.searchRow) {
        this.searchRow.addEventListener('click', () => {
          this.setMenu(false);
          // The hidden summary still drives Dawn's details-modal
          if (this.searchSummary) this.searchSummary.click();
        });
      }

      this.onDocClick = (e) => {
        if (
          this.resPanel && this.resPanel.classList.contains('is-open') &&
          !this.resPanel.contains(e.target) &&
          !(this.resToggle && this.resToggle.contains(e.target))
        ) this.setResources(false);
      };
      this.onKeydown = (e) => {
        if (e.key === 'Escape') { this.setResources(false); this.setMenu(false); }
      };
      document.addEventListener('click', this.onDocClick);
      document.addEventListener('keydown', this.onKeydown);
    }

    disconnectedCallback() {
      document.removeEventListener('click', this.onDocClick);
      document.removeEventListener('keydown', this.onKeydown);
      if (this.headerWrapper && this.onWrapperLeave) this.headerWrapper.removeEventListener('mouseleave', this.onWrapperLeave);
      document.body.classList.remove('overflow-hidden', 'st-menu-open');
    }

    setResources(open) {
      if (!this.resPanel) return;
      this.resPanel.classList.toggle('is-open', open);
      if (this.resToggle) this.resToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    setMenu(open) {
      if (!this.menuPanel) return;
      this.menuPanel.classList.toggle('is-open', open);
      if (this.menuToggle) {
        this.menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        this.menuToggle.setAttribute('aria-label', open ? 'Close menu' : this.menuToggle.dataset.label || 'Menu');
      }
      document.body.classList.toggle('st-menu-open', open);
      document.body.classList.toggle('overflow-hidden', open);
    }
  }

  if (!customElements.get('st-nav-menus')) customElements.define('st-nav-menus', StNavMenus);
{% endjavascript %}

<script defer="defer">
  {% if section.settings.enable_sticky_header %}
    const header = document.querySelector(".template-index #shopify-section-{{ section.id }}")

    document.addEventListener('scroll', function() {
      let root = document.documentElement;
      const scrollTop = document.body.scrollTop || document.documentElement.scrollTop
      const percentage = scrollTop / 100;
      const fixed = percentage.toFixed(2);

      document.querySelector("#shopify-section-{{ section.id }}").classList.toggle("scrolled", scrollTop > 10);
    })
  {% endif %}

  /* Keep --st-header-bottom (the header's rendered height) in sync at all
     times — the home hero sizes itself against it. */
  (function () {
    function updateHeaderBottom() {
      var bar = document.querySelector('.header-wrapper');
      if (bar) {
        document.documentElement.style.setProperty('--st-header-bottom', bar.offsetHeight + 'px');
      }
    }
    updateHeaderBottom();
    document.addEventListener('DOMContentLoaded', updateHeaderBottom);
    window.addEventListener('load', updateHeaderBottom);
    window.addEventListener('resize', updateHeaderBottom);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(updateHeaderBottom);
  })();
</script>

